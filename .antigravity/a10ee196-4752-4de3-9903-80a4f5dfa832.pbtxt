        replacement_chunks {
          target_content: "export const EXPERIENCE_DATA: ExperienceItem[] = [\n  {\n    id: \'exp-01\',\n    role: \'Praktik Kerja Nyata (PKN) \342\200\224 Pelayanan dan Informasi Kesehatan\',\n    organization: \'Puskesmas Poncol\',\n    location: \'Semarang, Indonesia\',\n    period: \'Januari\342\200\223Februari 2026\',\n    category: \'Primary Healthcare\',\n    summary:\n      \'Melaksanakan Praktik Kerja Nyata (PKN) pada pelayanan kesehatan tingkat pertama dengan mendukung layanan pendaftaran pasien, kelancaran alur informasi kesehatan, serta berpartisipasi dalam kegiatan kesehatan masyarakat.\',\n    highlights: [\n      \'Pelayanan pendaftaran dan dukungan alur administrasi pasien.\',\n      \'Partisipasi dalam program kesehatan masyarakat, termasuk penyuluhan jentik dan Prolanis.\',\n      \'Dukungan kegiatan pelayanan di Pustu serta CKG di sekolah.\',\n    ],\n    metrics: \'\',\n  },\n  {\n    id: \'exp-02\',\n    role: \'Praktik Kerja Lapangan (PKL) \342\200\224 Rekam Medis\',\n    organization: \'RSUD Bagas Waras Klaten\',\n    location: \'Klaten, Indonesia\',\n    period: \'Oktober\342\200\223November 2025\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Mengembangkan kompetensi pengelolaan rekam medis dan manajemen informasi kesehatan melalui pelatihan praktik lapangan berbasis rumah sakit.\',\n    highlights: [\n      \'[Placeholder: Tambahkan tugas atau kontribusi utama yang dilakukan pada unit rekam medis di RSUD Bagas Waras Klaten.]\',\n      \'[Placeholder: Tambahkan kegiatan pendukung dalam pengelolaan alur informasi kesehatan atau dokumentasi pasien.]\',\n      \'[Placeholder: Tambahkan aktivitas pembelajaran atau koordinasi operasional unit rekam medis selama periode PKL.]\',\n    ],\n    metrics: \'\',\n  },\n  {\n    id: \'exp-03\',\n    role: \'Praktik Kerja Lapangan (PKL) \342\200\224 Rekam Medis\',\n    organization: \'RSUD Gondo Suwarno Ungaran\',\n    location: \'Ungaran, Indonesia\',\n    period: \'April\342\200\223Mei 2025\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Menjalani praktik kerja lapangan sebagai bagian dari pengembangan akademik di bidang Rekam Medis dan Informasi Kesehatan, dengan fokus pada operasional rekam medis rumah sakit dan alur kerja informasi kesehatan.\',\n    highlights: [\n      \'[Placeholder: Tambahkan rincian kegiatan operasional rekam medis yang diikuti di RSUD Gondo Suwarno Ungaran.]\',\n      \'[Placeholder: Tambahkan aktivitas dukungan alur kerja informasi kesehatan atau pengelolaan dokumen pasien.]\',\n      \'[Placeholder: Tambahkan pengalaman praktik atau kolaborasi bersama petugas unit rekam medis selama PKL.]\',\n    ],\n    metrics: \'\',\n  },\n  {\n    id: \'exp-04\',\n    role: \'Praktik Kerja Lapangan (PKL) \342\200\224 Rekam Medis\',\n    organization: \'RS PKU Muhammadiyah Wonosobo\',\n    location: \'Wonosobo, Indonesia\',\n    period: \'Oktober\342\200\223November 2024\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Melaksanakan praktik kerja lapangan di lingkungan rumah sakit untuk mempelajari pengelolaan rekam medis serta alur manajemen informasi kesehatan secara terstruktur.\',\n    highlights: [\n      \'[Placeholder: Tambahkan rincian tugas spesifik yang dilaksanakan pada unit rekam medis di RS PKU Muhammadiyah Wonosobo.]\',\n      \'[Placeholder: Tambahkan kegiatan pendukung pengelolaan informasi kesehatan selama periode praktik.]\',\n      \'[Placeholder: Tambahkan pembelajaran lapangan yang diperoleh selama pelaksanaan PKL.]\',\n    ],\n    metrics: \'\',\n  },\n  {\n    id: \'exp-05\',\n    role: \'Praktik Kerja Lapangan (PKL) \342\200\224 Rekam Medis\',\n    organization: \'RSUD dr. Loekmono Hadi Kudus\',\n    location: \'Kudus, Indonesia\',\n    period: \'Mei\342\200\223Juni 2024\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Memperoleh pembelajaran dan pengenalan langsung terhadap operasional pengelolaan rekam medis serta tata kelola informasi kesehatan di lingkungan rumah sakit.\',\n    highlights: [\n      \'[Placeholder: Silakan lengkapi kegiatan atau tugas aktual yang dilakukan selama PKL di RSUD dr. Loekmono Hadi Kudus.]\',\n      \'[Placeholder: Silakan lengkapi aktivitas dukungan operasional rekam medis yang diikuti.]\',\n      \'[Placeholder: Silakan lengkapi pembelajaran utama terkait alur informasi kesehatan rumah sakit.]\',\n    ],\n    metrics: \'\',\n  },\n];"
          replacement_content: "export const EXPERIENCE_DATA: ExperienceItem[] = [\n  {\n    id: \'exp-01\',\n    role: \'Praktik Kerja Nyata (PKN) - Puskesmas Poncol\',\n    organization: \'\',\n    location: \'Semarang, Indonesia\',\n    period: \'Januari\342\200\223Februari 2026\',\n    category: \'Primary Healthcare\',\n    summary:\n      \'Melaksanakan Praktik Kerja Nyata (PKN) pada pelayanan kesehatan tingkat pertama dengan mendukung layanan pendaftaran pasien, kelancaran alur informasi kesehatan, serta berpartisipasi dalam kegiatan kesehatan masyarakat.\',\n    highlights: [\n      \'Pelayanan pendaftaran dan dukungan alur administrasi pasien.\',\n      \'Partisipasi dalam program kesehatan masyarakat, termasuk penyuluhan jentik dan Prolanis.\',\n      \'Dukungan kegiatan pelayanan di Pustu serta CKG di sekolah.\',\n    ],\n    metrics: \'\',\n  },\n  {\n    id: \'exp-02\',\n    role: \'Praktik Kerja Lapangan (PKL) - RSUD Bagas Waras Klaten\',\n    organization: \'\',\n    location: \'Klaten, Indonesia\',\n    period: \'Oktober\342\200\223November 2025\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Mengembangkan kompetensi pengelolaan rekam medis dan manajemen informasi kesehatan melalui pelatihan praktik lapangan berbasis rumah sakit.\',\n    highlights: [\n      \'[Placeholder: Tambahkan tugas atau kontribusi utama yang dilakukan pada unit rekam medis di RSUD Bagas Waras Klaten.]\',\n      \'[Placeholder: Tambahkan kegiatan pendukung dalam pengelolaan alur informasi kesehatan atau dokumentasi pasien.]\',\n      \'[Placeholder: Tambahkan aktivitas pembelajaran atau koordinasi operasional unit rekam medis selama periode PKL.]\',\n    ],\n    metrics: \'\',\n  },\n  {\n    id: \'exp-03\',\n    role: \'Praktik Kerja Lapangan (PKL) - RSUD Gondo Suwarno Ungaran\',\n    organization: \'\',\n    location: \'Ungaran, Indonesia\',\n    period: \'April\342\200\223Mei 2025\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Menjalani praktik kerja lapangan sebagai bagian dari pengembangan akademik di bidang Rekam Medis dan Informasi Kesehatan, dengan fokus pada operasional rekam medis rumah sakit dan alur kerja informasi kesehatan.\',\n    highlights: [\n      \'[Placeholder: Tambahkan rincian kegiatan operasional rekam medis yang diikuti di RSUD Gondo Suwarno Ungaran.]\',\n      \'[Placeholder: Tambahkan aktivitas dukungan alur kerja informasi kesehatan atau pengelolaan dokumen pasien.]\',\n      \'[Placeholder: Tambahkan pengalaman praktik atau kolaborasi bersama petugas unit rekam medis selama PKL.]\',\n    ],\n    metrics: \'\',\n  },\n  {\n    id: \'exp-04\',\n    role: \'Praktik Kerja Lapangan (PKL) - RS PKU Muhammadiyah Wonosobo\',\n    organization: \'\',\n    location: \'Wonosobo, Indonesia\',\n    period: \'Oktober\342\200\223November 2024\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Melaksanakan praktik kerja lapangan di lingkungan rumah sakit untuk mempelajari pengelolaan rekam medis serta alur manajemen informasi kesehatan secara terstruktur.\',\n    highlights: [\n      \'[Placeholder: Tambahkan rincian tugas spesifik yang dilaksanakan pada unit rekam medis di RS PKU Muhammadiyah Wonosobo.]\',\n      \'[Placeholder: Tambahkan kegiatan pendukung pengelolaan informasi kesehatan selama periode praktik.]\',\n      \'[Placeholder: Tambahkan pembelajaran lapangan yang diperoleh selama pelaksanaan PKL.]\',\n    ],\n    metrics: \'\',\n  },\n  {\n    id: \'exp-05\',\n    role: \'Praktik Kerja Lapangan (PKL) - RSUD dr. Loekmono Hadi Kudus\',\n    organization: \'\',\n    location: \'Kudus, Indonesia\',\n    period: \'Mei\342\200\223Juni 2024\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Memperoleh pembelajaran dan pengenalan langsung terhadap operasional pengelolaan rekam medis serta tata kelola informasi kesehatan di lingkungan rumah sakit.\',\n    highlights: [\n      \'[Placeholder: Silakan lengkapi kegiatan atau tugas aktual yang dilakukan selama PKL di RSUD dr. Loekmono Hadi Kudus.]\',\n      \'[Placeholder: Silakan lengkapi aktivitas dukungan operasional rekam medis yang diikuti.]\',\n      \'[Placeholder: Silakan lengkapi pembelajaran utama terkait alur informasi kesehatan rumah sakit.]\',\n    ],\n    metrics: \'\',\n  },\n];"
