            }
            lines {
              text: "    Math.min(0.55, (card.x - j3.x) * 0.65)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const targetRotX = Math.max("
