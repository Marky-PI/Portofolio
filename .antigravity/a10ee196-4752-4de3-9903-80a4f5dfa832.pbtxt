    tool_calls {
      id: "call_582787"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { ArrowDown, Pause, Play, Sparkles } from \'lucide-react\';\\nimport { PROFILE_DATA, type NavSectionId } from \'../data/portfolioData\';\\nimport { getMarqueeDurationSeconds } from \'../utils/portfolioLogic\';\\n\\ninterface HeroSectionProps {\\n  darkMode: boolean;\\n  onNavigate: (sectionId: NavSectionId) => void;\\n}\\n\\nexport const HeroSection: React.FC<HeroSectionProps> = ({\\n  darkMode,\\n  onNavigate,\\n}) => {\\n  const [monochromePortrait, setMonochromePortrait] = useState<boolean>(true);\\n  const [isPaused, setIsPaused] = useState<boolean>(false);\\n  const [imageError, setImageError] = useState<boolean>(false);\\n\\n  const marqueeDuration = getMarqueeDurationSeconds(\'normal\');\\n  const marqueeItems = [\\n    \'PORTOFOLIO\',\\n    \'MAHESA RIZKY PUTRA\',\\n    \'PORTOFOLIO\',\\n    \'MAHESA RIZKY PUTRA\',\\n  ];\\n\\n  const renderMarqueeTrack = (isOverlay: boolean) => (\\n    <div\\n      className={`animate-marquee-left ${isPaused ? \'marquee-paused\' : \'\'}`}\\n      style={{ \'--marquee-duration\': `${marqueeDuration}s` } as React.CSSProperties}\\n    >\\n      {[0, 1].map((groupIndex) => (\\n        <div\\n          key={groupIndex}\\n          className=\\\"flex items-center shrink-0\\\"\\n          aria-hidden={groupIndex === 1 || isOverlay ? \'true\' : undefined}\\n        >\\n          {marqueeItems.map((word, idx) => (\\n            <span\\n              key={`${groupIndex}-${idx}`}\\n              className={`font-display font-extrabold text-[clamp(6.5rem,18vw,17rem)] leading-none tracking-[0.04em] uppercase pr-12 sm:pr-20 select-none ${\\n                darkMode\\n                  ? isOverlay\\n                    ? \'stroke-text-dark-overlay\'\\n                    : \'stroke-text-dark\'\\n                  : isOverlay\\n                    ? \'stroke-text-light-overlay\'\\n                    : \'stroke-text-light\'\\n              }`}\\n            >\\n              {word}\\n            </span>\\n          ))}\\n        </div>\\n      ))}\\n    </div>\\n  );\\n\\n  return (\\n    <section\\n      id=\\\"home\\\"\\n      aria-label=\\\"Beranda Portofolio Mahesa\\\"\\n      className={`relative min-h-screen w-full overflow-hidden flex flex-col justify-end transition-colors duration-500 ${\\n        darkMode ? \'bg-[#0B0B0D] text-zinc-100\' : \'bg-[#E5E5E5] text-zinc-900\'\\n      }`}\\n    >\\n      {/* Subtle Monochrome Studio Lighting Vignette */}\\n      <div\\n        aria-hidden=\\\"true\\\"\\n        className={`pointer-events-none absolute inset-0 ${\\n          darkMode\\n            ? \'bg-[radial-gradient(circle_at_50%_42%,rgba(255,255,255,0.07)_0%,rgba(0,0,0,0.6)_75%)]\'\\n            : \'bg-[radial-gradient(circle_at_50%_42%,rgba(255,255,255,0.55)_0%,rgba(212,212,216,0.45)_78%)]\'\\n        }`}\\n      />\\n\\n      {/* LAYER 1 (z-10): Giant Running Text \\\"PORTOFOLIO\\\" Behind Portrait */}\\n      <div className=\\\"pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 z-10 overflow-hidden flex items-center\\\">\\n        {renderMarqueeTrack(false)}\\n      </div>\\n\\n      {/* LAYER 2 (z-20): Centered Foreground Portrait (porto.png) */}\\n      <div className=\\\"relative z-20 w-full max-w-[1440px] mx-auto px-4 sm:px-8 pt-28 flex flex-col items-center justify-end min-h-screen\\\">\\n        <div className=\\\"relative w-full max-w-[540px] sm:max-w-[600px] lg:max-w-[650px] flex justify-center items-end\\\">\\n          {!imageError ? (\\n            <img\\n              src={PROFILE_DATA.portraitSrc}\\n              alt=\\\"Potret Mahesa Rizky Putra\\\"\\n              referrerPolicy=\\\"no-referrer\\\"\\n              onError={() => setImageError(true)}\\n              className={`w-auto h-[64vh] sm:h-[74vh] lg:h-[82vh] max-h-[780px] object-contain object-bottom select-none transition-all duration-500 drop-shadow-[0_22px_45px_rgba(0,0,0,0.22)] ${\\n                monochromePortrait\\n                  ? \'grayscale contrast-[1.12] brightness-[1.02]\'\\n                  : \'grayscale-0 contrast-100\'\\n              }`}\\n            />\\n          ) : (\\n            <div\\n              className={`w-80 h-[65vh] rounded-t-3xl border flex flex-col items-center justify-center p-8 text-center ${\\n                darkMode\\n                  ? \'bg-zinc-900 border-white/15 text-zinc-200\'\\n                  : \'bg-zinc-200 border-zinc-900/15 text-zinc-800\'\\n              }`}\\n            >\\n              <span className=\\\"font-display text-5xl font-bold mb-3\\\">M</span>\\n              <p className=\\\"font-display font-semibold text-lg\\\">\\n                {PROFILE_DATA.fullName}\\n              </p>\\n              <p className=\\\"text-xs opacity-75 mt-1\\\">\\n                {PROFILE_DATA.institution}\\n              </p>\\n            </div>\\n          )}\\n        </div>\\n      </div>\\n\\n      {/* LAYER 3 (z-30): Synchronized Subtle Outline Pass (matches image.png stroke depth effect) */}\\n      <div\\n        aria-hidden=\\\"true\\\"\\n        className=\\\"pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 z-30 overflow-hidden flex items-center opacity-50\\\"\\n      >\\n        {renderMarqueeTrack(true)}\\n      </div>\\n\\n      {/* Bottom-Left Editorial Identity & Studio Controls */}\\n      <div className=\\\"absolute bottom-6 left-4 sm:left-8 z-40 max-w-xs sm:max-w-sm\\\">\\n        <div\\n          className={`rounded-2xl backdrop-blur-md border p-4 transition-colors ${\\n            darkMode\\n              ? \'bg-zinc-900/70 border-white/12 text-zinc-100\'\\n              : \'bg-white/70 border-zinc-900/10 text-zinc-900\'\\n          }`}\\n        >\\n          <p className=\\\"font-mono text-[11px] tracking-[0.16em] uppercase opacity-70\\\">\\n            {PROFILE_DATA.institution}\\n          </p>\\n          <h1 className=\\\"font-display font-bold text-base sm:text-lg tracking-tight mt-0.5\\\">\\n            {PROFILE_DATA.fullName}\\n          </h1>\\n          <p className=\\\"text-xs opacity-75 mt-1 leading-relaxed\\\">\\n            {PROFILE_DATA.roleHeadline}\\n          </p>\\n\\n          {/* Interactive Studio Controls for Portrait & Running Text */}\\n          <div className=\\\"mt-3 pt-2.5 border-t border-current/10 flex items-center gap-2 flex-wrap\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setMonochromePortrait((prev) => !prev)}\\n              className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-medium border transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                monochromePortrait\\n                  ? darkMode\\n                    ? \'bg-white text-zinc-950 border-white\'\\n                    : \'bg-zinc-900 text-white border-zinc-900\'\\n                  : darkMode\\n                    ? \'border-white/20 text-zinc-300 hover:bg-white/10\'\\n                    : \'border-zinc-900/20 text-zinc-700 hover:bg-zinc-900/5\'\\n              }`}\\n            >\\n              <Sparkles className=\\\"w-3 h-3\\\" />\\n              <span>{monochromePortrait ? \'B&W Studio\' : \'Warna Asli\'}</span>\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setIsPaused((prev) => !prev)}\\n              className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-medium border transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                darkMode\\n                  ? \'border-white/20 text-zinc-300 hover:bg-white/10\'\\n                  : \'border-zinc-900/20 text-zinc-700 hover:bg-zinc-900/5\'\\n              }`}\\n            >\\n              {isPaused ? (\\n                <>\\n                  <Play className=\\\"w-3 h-3\\\" />\\n                  <span>Jalankan Teks</span>\\n                </>\\n              ) : (\\n                <>\\n                  <Pause className=\\\"w-3 h-3\\\" />\\n                  <span>Jeda Teks</span>\\n                </>\\n              )}\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Bottom-Right Vertical \\\"SCROLL DOWN\\\" Indicator matching reference image.png */}\\n      <button\\n        type=\\\"button\\\"\\n        onClick={() => onNavigate(\'about\')}\\n        aria-label=\\\"Scroll Down ke Bagian About\\\"\\n        className=\\\"group absolute bottom-6 right-5 sm:right-9 z-40 flex flex-col items-center gap-3 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4\\\"\\n      >\\n        <span\\n          className={`w-[1px] h-12 sm:h-16 transition-all duration-300 group-hover:h-20 ${\\n            darkMode ? \'bg-zinc-400\' : \'bg-zinc-600\'\\n          }`}\\n        />\\n        <span\\n          className={`font-sans text-[10px] font-semibold tracking-[0.28em] uppercase [writing-mode:vertical-rl] transition-colors ${\\n            darkMode\\n              ? \'text-zinc-400 group-hover:text-white\'\\n              : \'text-zinc-600 group-hover:text-zinc-950\'\\n          }`}\\n        >\\n          Scroll Down\\n        </span>\\n        <ArrowDown\\n          className={`w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-y-1 ${\\n            darkMode ? \'text-zinc-400\' : \'text-zinc-600\'\\n          }`}\\n        />\\n      </button>\\n    </section>\\n  );\\n};\\n\", \"Description\":\"Create HeroSection component matching image.png with running PORTOFOLIO marquee behind Mahesa portrait\", \"Overwrite\":true, \"TargetFile\":\"/src/components/HeroSection.tsx\", \"toolAction\":\"Creating HeroSection component\", \"toolSummary\":\"Create HeroSection.tsx\"}"
      original_name: "write_to_file"
    }
