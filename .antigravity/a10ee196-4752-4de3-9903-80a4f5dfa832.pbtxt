  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { COMPETENCIES_DATA } from \'../data/portfolioData\';\nimport { filterCompetenciesByCategory } from \'../utils/portfolioLogic\';\n\ninterface CompetenciesSectionProps {\n  darkMode: boolean;\n}\n\nconst COMPETENCY_CATEGORIES = [\n  \'All\',\n  \'Digital & Technical\',\n  \'Analytical & Research\',\n  \'Leadership & Operations\',\n] as const;\n\nexport const CompetenciesSection: React.FC<CompetenciesSectionProps> = ({\n  darkMode,\n}) => {\n  const [activeCategory, setActiveCategory] = useState<string>(\'All\');\n  const filteredCompetencies = filterCompetenciesByCategory(\n    COMPETENCIES_DATA,\n    activeCategory\n  );\n\n  return (\n    <section\n      id=\"competencies\"\n      aria-labelledby=\"competencies-heading\"\n      className={`py-24 sm:py-32 px-4 sm:px-8 border-t transition-colors duration-300 ${\n        darkMode\n          ? \'bg-[#0F0F12] border-white/10 text-zinc-100\'\n          : \'bg-[#F4F4F5] border-zinc-900/10 text-zinc-900\'\n      }`}\n    >\n      <div className=\"max-w-[1160px] mx-auto\">\n        {/* Header & Filter */}\n        <div className=\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-12 border-b border-current/10\">\n          <div>\n            <p className=\"font-mono text-xs tracking-[0.18em] uppercase opacity-60\">\n              03 \302\267 Keahlian & Kapabilitas\n            </p>\n            <h2\n              id=\"competencies-heading\"\n              className=\"font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight mt-2 text-balance\"\n            >\n              Matriks Kompetensi Inti.\n            </h2>\n          </div>\n\n          <div\n            role=\"group\"\n            aria-label=\"Filter Kategori Kompetensi\"\n            className={`inline-flex flex-wrap items-center gap-1 p-1.5 rounded-xl border ${\n              darkMode\n                ? \'bg-zinc-900/80 border-white/10\'\n                : \'bg-white border-zinc-900/10\'\n            }`}\n          >\n            {COMPETENCY_CATEGORIES.map((category) => {\n              const active = activeCategory === category;\n              return (\n                <button\n                  key={category}\n                  type=\"button\"\n                  onClick={() => setActiveCategory(category)}\n                  className={`px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer whitespace-nowrap shrink-0 ${\n                    active\n                      ? darkMode\n                        ? \'bg-white text-zinc-950 font-semibold shadow-sm\'\n                        : \'bg-zinc-950 text-white font-semibold shadow-sm\'\n                      : darkMode\n                        ? \'text-zinc-400 hover:text-white\'\n                        : \'text-zinc-600 hover:text-zinc-950\'\n                  }`}\n                >\n                  {category}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Competency Cards Grid */}\n        <div className=\"mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {filteredCompetencies.map((comp, index) => (\n            <article\n              key={comp.id}\n              className={`rounded-2xl border p-6 sm:p-7 flex flex-col justify-between transition-all duration-200 ${\n                darkMode\n                  ? \'bg-zinc-900/50 border-white/10 hover:border-white/25\'\n                  : \'bg-white border-zinc-900/10 hover:border-zinc-900/25\'\n              }`}\n            >\n              <div>\n                {/* Clean Unboxed Metadata */}\n                <div className=\"flex items-center justify-between gap-2 text-xs font-mono opacity-60 tabular-nums\">\n                  <span>0{index + 1} \302\267 {comp.category}</span>\n                  <span>{comp.proficiency}%</span>\n                </div>\n\n                <h3 className=\"font-display font-bold text-lg sm:text-xl tracking-tight mt-3\">\n                  {comp.title}\n                </h3>\n\n                <p\n                  className={`text-sm leading-relaxed mt-3 ${\n                    darkMode ? \'text-zinc-300\' : \'text-zinc-600\'\n                  }`}\n                >\n                  {comp.description}\n                </p>\n              </div>\n\n              <div className=\"mt-6 pt-5 border-t border-current/10\">\n                {/* Monochrome Progress Bar */}\n                <div className=\"w-full h-1.5 rounded-full overflow-hidden bg-current/10\">\n                  <div\n                    className={`h-full rounded-full transition-all duration-500 ${\n                      darkMode ? \'bg-zinc-100\' : \'bg-zinc-900\'\n                    }`}\n                    style={{ width: `${comp.proficiency}%` }}\n                  />\n                </div>\n\n                {/* Unboxed Tools List with Typographic Separators */}\n                <p className=\"mt-3 text-xs opacity-70 leading-relaxed\">\n                  {comp.tools.join(\' \302\267 \')}\n                </p>\n              </div>\n            </article>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/CompetenciesSection.tsx"
        }
        overwrite: true
      }
    }
