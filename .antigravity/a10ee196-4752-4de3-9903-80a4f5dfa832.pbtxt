      thinking_signature: "\022\222\a\n\217\a\001i\024}\023\303\236\033\272\035\220\307\325,\237\'\333X1c\225\305\265\t\362\024\n\342\202\322\023!Q\276E\032ZC\"\265\310\177{i^\031\307\261L\0170 \214\037\224\026\324\340\330m\355j\026\035W%\305#&\360h|\306D\307>\033j\204\341l\tAH\n\277Th\322\237\006\371z6\303\312\350\260\b y\304\032US\207\313~\216\034h\343\026\326^<;\321_Dm+@\346\343\024\204y\325:\343\333V\023:|\ni\305L\217\332\r.\304\246\026c\024\333\t\037\277\352E\030\023\214\033QJm\346\274>\255V\234\342m\346\r/\276\270\365\fv\353td\342\245A\217\224\3443\2151\361\345\312dAz\"C\222\322-\033\263k\222\2075\001\303\0237\335\213\374\273\361,\032x\363u2\344\017\b\003&6/z*\272\tJ\241?\026\205O\205?\272\206\341\354P\375&%.\347\274Z\362&\357kYZ{\217\257\337\006\361NS\250\373\273\253\371\276\252\314\242\b\350\b\234\232\225eHF\352k}\037V\236\244\231\246\234xR=\034\333\032i*\201\370\370\262\270\301\240\220=\032G\231\305c\233\236?C\270\371`V\276\017C\202\270\226\322|\232\274\2226\217\026\315\324\310\r\221\336K\243\245\250ca\341Q\032c\234\023#\242U3\017E8\003\201\254\263?\376`\260|c\260\365Gr\357\3523\304\030\277)\304\343_\3723\020\372;\342\264\306\320\327&@\177b\253J\306\3161\3203\265W\236\365\vmf(\312rt\210\273\301,/}\003\213\246mJ\262\344{X\240\224\\xB\217\361\2625uFYD\227\371\306\322qT\264\323\033i{\236S\236<k\033)\026\334*\300\206\313\006~\350d[zo\323#\023\256\031 :B#\376\304\250n\361\3370\355\226z\200\1774\304\024\215Mq\275:\3312\253\3314\203\304H\335\266F\035\223\223\3436e\315\337\250aT\221\037\346\304;-\370d\\\262p>R\324/\3553\240{~\304\n\305\255_\213\332\225\355L\344\331=z\305Q\340\245\226\350\254\214\037\351\263\261\272\362\251\304H\354\n\n\366\355S\003-\2224<\341G\252\221\343\177t\372\354.\302\332\020b\302\353\303\002\313\327\361,l7N\372\276@\237[\263\177\3455)\211\312N\367\033+|.\257\203H\371\0221\316\340\222\356w\254\365O$C\222\315K\310x\2434\2510\a\314\343\206rtcK\242~s\216E\362\211<\326\001\222mG\341k^r\327\215o\327\233$\b\177\211\203\035\342d\203\023q\243\030\033\273nh\a\375\263\023*\002,\220[\n\264\333\020\354\337\207\273\234\021\365\304-R\316\177U\037\342]\234\257\f\222>\317\345\276=\025\267\b-\017g2~\262\\\367\251\351\277\262\224:(\317\353\003\370\202\243\237\016\203\037\351\267\216\204\246\231\355$\apE\261\024\371\217s\'\371\311`\311\252\217p7\306_\256b/]\212$ZP\3534\262\271\b\341\357)\357[}(7\327j@\315\032\237fRh\253w\270\323\370\000\353\212\267\330\330\v\300`\263\265.f\204\032\241\343\003\373!\312::\037\260\262\303\320~\270\006^\344e\006\031\267\302\365\026\006\a(K[\337?\261\n0W\307\025\215\223\305O\260\336\022\332v\376\261\334\236N+I\222$?!\301O\267"
