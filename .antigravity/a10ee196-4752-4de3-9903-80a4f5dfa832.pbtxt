            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      for (let i = 0; i <= ribbonSegments; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const pt = sampled[i];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Slight twist along the card\'s Y rotation near the bottom of the strap"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const t = 1 - i / ribbonSegments;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
