      thinking_signature: "\022\256\n\n\253\n\001i\024}\023C\247\357\261\311\232\'qqR$\276&^\213)\021(\026\344Cm\0346\024\261\006\3678U\035%n\220\253\254\005.\323\332]a\034\257\270e\313\213\240\242D[\311\3307\023\b\026c\227\020C\006a1\fd\274\273u\231\306\266\034\276\372\340\245\316`\232\244\b\250\023\325>U\321]\230\206?\233\374S\200<\352L\032\365\231Z\371\342\375y\254\224\220\275\251\305J\001\266;\341\000\336Y\275f\252\223\207\341\322\262\247\2323\202\'\251\'\324\276\210d\352a\312\355\2430_\317ST;1\374\306\323NWZ\300\370{\031p\311\326\033\0012\356F/\306O\323\r\377\373\250F\266\023*\321\223u\rv\312\305:\377\227\177\340\026\347\362\337\324+G\006^\017[\030;\332FE4t\003R\t!6\343\263\212\3104\312\264/\260\311\026\004\350\212\r\212\343\374\0175\224Q0u{\005\311N\326x\204\f\375%g\313\327\337\016\242\3151\2143\352\212IU\213\033\253\365\255a%\351uQ$\225\316\267\304\2125\241I;\221I\300\236c-\275\3063\020\302\255\3746\3450\353G\346\030Nn\300u\244\232s\226\2341\235\025]\312E\302\033\337\307\276\243\346\260\024\232\001\234\272H\326\261P\356\006U{x+D\321\025N\333/W\354M\357\016\260\223\235\325\'\023\2523t\216#\227\314<\036>\a\nv\201\vl\321lHy}|J@\220\334!\252\262\367\226\331\260,\225zT\232\3402\276\350\226\240{\244\002v\224\006\005f\0006\264F\315!\233\rf\273N\334\\\n|\324l\255j\\4\264\270QS\264a`Z\203\213\034\0267\226\3517H\035\300qt\334\001s\226\020Ak\252\240\025\217Cf-\214g\313y\323\2349\363\337\241\"\317=\230^,o\230{>\030\270\332\001\226\233\024#ho~\345`\006\227\257\2370\313\2560N\331o\a\233\2269\313\254O#\177\223\023T\345\326\204\277J\241\3768tiW\034U@\216\253\201Z\005\334-\177\241\325\\\006\233\276WFHB\307\302\267\211\'\241V!\333\277\317\245\364E\351\316w\242]\347\303J\336\rs*.~kD=\257\272\260v\307\223\017\224\270\303\321\a\374\367.\331\372{\374h\376\'\305\252a3\003}G\201g`\316\346\323\317\355\324b\226BM}\373\b\305\037\'\372}\b.\331T%\211\232\"Y\307\317A[\370\311\270\220\267\310n\301b1w\242\026\256\027\351O\324;\362`\335\246&\224\236 \364\301\b35\204\305\255y\2105\332\322\024