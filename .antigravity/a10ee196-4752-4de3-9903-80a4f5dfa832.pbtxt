    is_skill_file: true
    skill_metadata {
      name: "threejs"
      description: "Comprehensive guide for Three.js development. Use when creating 3D scenes, animating objects, handling user interaction, loading assets, applying materials and textures, or creating custom shaders and post-processing effects."
    }
