  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Award, CheckCircle2, Search, X } from \'lucide-react\';\nimport {\n  CERTIFICATION_DATA,\n  PROFILE_DATA,\n  type CertificationItem,\n} from \'../data/portfolioData\';\nimport { filterCertifications } from \'../utils/portfolioLogic\';\n\ninterface CertificationSectionProps {\n  darkMode: boolean;\n}\n\nexport const CertificationSection: React.FC<CertificationSectionProps> = ({\n  darkMode,\n}) => {\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [selectedCert, setSelectedCert] = useState<CertificationItem | null>(\n    null\n  );\n\n  const filteredCerts = filterCertifications(CERTIFICATION_DATA, searchQuery);\n\n  return (\n    <section\n      id=\"certification\"\n      aria-labelledby=\"certification-heading\"\n      className={`py-24 sm:py-32 px-4 sm:px-8 border-t transition-colors duration-300 ${\n        darkMode\n          ? \'bg-[#0B0B0D] border-white/10 text-zinc-100\'\n          : \'bg-[#E5E5E5] border-zinc-900/10 text-zinc-900\'\n      }`}\n    >\n      <div className=\"max-w-[1160px] mx-auto\">\n        {/* Section Header & Search */}\n        <div className=\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-12 border-b border-current/10\">\n          <div>\n            <p className=\"font-mono text-xs tracking-[0.18em] uppercase opacity-60\">\n              04 \302\267 Kredensial & Lisensi\n            </p>\n            <h2\n              id=\"certification-heading\"\n              className=\"font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight mt-2 text-balance\"\n            >\n              Sertifikasi & Pelatihan Resmi.\n            </h2>\n          </div>\n\n          <div className=\"w-full lg:w-80\">\n            <label htmlFor=\"cert-search\" className=\"sr-only\">\n              Cari Sertifikasi atau ID Kredensial\n            </label>\n            <div\n              className={`flex items-center gap-2.5 px-4 py-2.5 rounded-xl border ${\n                darkMode\n                  ? \'bg-zinc-900/80 border-white/15 text-zinc-100\'\n                  : \'bg-white/85 border-zinc-900/15 text-zinc-900\'\n              }`}\n            >\n              <Search className=\"w-4 h-4 opacity-50 shrink-0\" />\n              <input\n                id=\"cert-search\"\n                type=\"search\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Cari sertifikasi, lembaga, atau ID...\"\n                className=\"w-full bg-transparent text-xs sm:text-sm focus:outline-none placeholder:opacity-50\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Certifications Grid */}\n        {filteredCerts.length === 0 ? (\n          <div\n            className={`mt-12 rounded-2xl border p-12 text-center ${\n              darkMode\n                ? \'bg-zinc-900/40 border-white/10\'\n                : \'bg-white/70 border-zinc-900/10\'\n            }`}\n          >\n            <p className=\"font-display font-semibold text-lg\">\n              Sertifikasi tidak ditemukan\n            </p>\n            <p className=\"text-xs opacity-65 mt-1\">\n              Tidak ada sertifikasi yang cocok dengan kata kunci &ldquo;{searchQuery}&rdquo;.\n            </p>\n            <button\n              type=\"button\"\n              onClick={() => setSearchQuery(\'\')}\n              className=\"mt-4 px-4 py-2 rounded-xl text-xs font-semibold border border-current/20 cursor-pointer\"\n            >\n              Reset Pencarian\n            </button>\n          </div>\n        ) : (\n          <div className=\"mt-12 grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {filteredCerts.map((cert, index) => (\n              <article\n                key={cert.id}\n                className={`rounded-2xl border p-6 sm:p-8 flex flex-col justify-between transition-all duration-200 ${\n                  darkMode\n                    ? \'bg-zinc-900/60 border-white/10 hover:border-white/25\'\n                    : \'bg-white/85 border-zinc-900/10 hover:border-zinc-900/25\'\n                }`}\n              >\n                <div>\n                  {/* Clean Unboxed Metadata */}\n                  <div className=\"flex flex-wrap items-center gap-2 text-xs font-mono opacity-65 tabular-nums\">\n                    <span>0{index + 1}</span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <span>{cert.category}</span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <span>{cert.issueDate}</span>\n                  </div>\n\n                  <h3 className=\"font-display font-bold text-xl tracking-tight mt-3\">\n                    {cert.title}\n                  </h3>\n\n                  <p className=\"text-xs sm:text-sm font-medium opacity-80 mt-1.5\">\n                    {cert.issuer}\n                  </p>\n\n                  <p\n                    className={`text-sm leading-relaxed mt-4 ${\n                      darkMode ? \'text-zinc-300\' : \'text-zinc-600\'\n                    }`}\n                  >\n                    {cert.summary}\n                  </p>\n                </div>\n\n                <div className=\"mt-6 pt-5 border-t border-current/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                  <div className=\"text-xs font-mono opacity-70 tabular-nums\">\n                    ID: {cert.credentialId}\n                  </div>\n\n                  <button\n                    type=\"button\"\n                    onClick={() => setSelectedCert(cert)}\n                    aria-label={`Verifikasi Sertifikat ${cert.title}`}\n                    className={`inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold border transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\n                      darkMode\n                        ? \'border-white/20 text-zinc-100 hover:bg-white hover:text-zinc-950\'\n                        : \'border-zinc-900/20 text-zinc-900 hover:bg-zinc-950 hover:text-white\'\n                    }`}\n                  >\n                    <Award className=\"w-3.5 h-3.5\" />\n                    <span>Detail Kredensial</span>\n                  </button>\n                </div>\n              </article>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Certificate Verification Modal */}\n      {selectedCert && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"cert-modal-title\"\n          className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm\"\n        >\n          <div\n            className={`w-full max-w-xl rounded-2xl border p-6 sm:p-8 ${\n              darkMode\n                ? \'bg-zinc-900 border-white/15 text-zinc-100\'\n                : \'bg-white border-zinc-900/15 text-zinc-900\'\n            }`}\n          >\n            <div className=\"flex items-start justify-between gap-4 pb-4 border-b border-current/10\">\n              <div>\n                <p className=\"font-mono text-xs uppercase tracking-widest opacity-60\">\n                  VERIFIKASI SERTIFIKAT KOMPETENSI\n                </p>\n                <h3\n                  id=\"cert-modal-title\"\n                  className=\"font-display font-bold text-xl mt-1\"\n                >\n                  {selectedCert.title}\n                </h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setSelectedCert(null)}\n                aria-label=\"Tutup Detail Sertifikat\"\n                className=\"p-2 rounded-lg border border-current/15 hover:bg-current/5 cursor-pointer\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* Monochrome Certificate Preview Frame */}\n            <div\n              className={`mt-6 rounded-xl border p-6 ${\n                darkMode\n                  ? \'bg-zinc-950/80 border-white/10\'\n                  : \'bg-zinc-50 border-zinc-900/10\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between text-xs font-mono opacity-60 pb-4 border-b border-current/10 tabular-nums\">\n                <span>CREDENTIAL ID: {selectedCert.credentialId}</span>\n                <span>{selectedCert.issueDate}</span>\n              </div>\n\n              <div className=\"py-5\">\n                <p className=\"text-xs uppercase tracking-widest opacity-60\">\n                  Diberikan Kepada\n                </p>\n                <p className=\"font-display font-bold text-2xl mt-1\">\n                  {PROFILE_DATA.fullName}\n                </p>\n                <p className=\"text-xs opacity-75 mt-2\">\n                  Diterbitkan secara resmi oleh <strong>{selectedCert.issuer}</strong>\n                </p>\n              </div>\n\n              <div className=\"pt-4 border-t border-current/10 flex items-center justify-between text-xs\">\n                <span className=\"inline-flex items-center gap-1.5 font-medium\">\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                  <span>Status: Terverifikasi & Aktif</span>\n                </span>\n                <span className=\"font-mono opacity-60\">\n                  {selectedCert.category}\n                </span>\n              </div>\n            </div>\n\n            <div className=\"mt-5\">\n              <p className=\"font-mono text-xs uppercase tracking-wider opacity-60\">\n                Kompetensi yang Diuji\n              </p>\n              <p className=\"text-xs sm:text-sm mt-1.5 opacity-85\">\n                {selectedCert.verifiedSkills.join(\' \302\267 \')}\n              </p>\n            </div>\n\n            <div className=\"mt-6 pt-4 border-t border-current/10 flex justify-end\">\n              <button\n                type=\"button\"\n                onClick={() => setSelectedCert(null)}\n                className={`px-5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer ${\n                  darkMode\n                    ? \'bg-white text-zinc-950 hover:bg-zinc-200\'\n                    : \'bg-zinc-950 text-white hover:bg-zinc-800\'\n                }`}\n              >\n                Tutup Pratinjau\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/CertificationSection.tsx"
        }
        overwrite: true
      }
    }
