    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "import React, { useEffect, useRef, useState } from \'react\';\nimport * as THREE from \'three\';\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\nimport { PROFILE_DATA } from \'../data/portfolioData\';\nimport {\n  createLanyardPhysicsState,\n  resetLanyardDrop,\n  stepLanyardPhysics,\n} from \'../utils/lanyardPhysics\';\n\nfunction createLanyardStrapTexture(maxAnisotropy: number): THREE.CanvasTexture {\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = 1024;\n  canvas.height = 128;\n  const ctx = canvas.getContext(\'2d\')!;\n\n  // Matte jet-black strap background\n  ctx.fillStyle = \'#09090B\';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n  // Subtle woven nylon texture lines\n  ctx.strokeStyle = \'rgba(255,255,255,0.06)\';\n  ctx.lineWidth = 2;\n  for (let x = 0; x < canvas.width; x += 8) {\n    ctx.beginPath();\n    ctx.moveTo(x, 0);\n    ctx.lineTo(x, canvas.height);\n    ctx.stroke();\n  }\n\n  // Repeating \"MAHESA\" print along the strap matching reference video\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.font = \'800 44px \"Outfit\", sans-serif\';\n  ctx.textAlign = \'center\';\n  ctx.textBaseline = \'middle\';\n  ctx.fillText(\n    \'MAHESA      \342\230\205      MAHESA      \342\230\205\',\n    canvas.width / 2,\n    canvas.height / 2 + 2\n  );\n\n  const texture = new THREE.CanvasTexture(canvas);\n  texture.colorSpace = THREE.SRGBColorSpace;\n  texture.wrapS = THREE.RepeatWrapping;\n  texture.wrapT = THREE.RepeatWrapping;\n  texture.repeat.set(3, 1);\n  texture.anisotropy = maxAnisotropy;\n  texture.needsUpdate = true;\n  return texture;\n}\n\nfunction drawCardFrontCanvas(\n  canvas: HTMLCanvasElement,\n  portraitImg?: HTMLImageElement\n) {\n  const ctx = canvas.getContext(\'2d\')!;\n  const w = canvas.width;\n  const h = canvas.height;\n\n  // 1. Sleek Monochrome Studio Backdrop (like the reference video badge)\n  const bgGrad = ctx.createLinearGradient(0, 0, 0, h);\n  bgGrad.addColorStop(0, \'#27272A\');\n  bgGrad.addColorStop(0.55, \'#18181B\');\n  bgGrad.addColorStop(1, \'#09090B\');\n  ctx.fillStyle = bgGrad;\n  ctx.fillRect(0, 0, w, h);\n\n  // Subtle radial studio spotlight behind the subject\n  const radial = ctx.createRadialGradient(\n    w / 2,\n    h * 0.44,\n    50,\n    w / 2,\n    h * 0.44,\n    w * 0.65\n  );\n  radial.addColorStop(0, \'rgba(255,255,255,0.22)\');\n  radial.addColorStop(1, \'rgba(0,0,0,0)\');\n  ctx.fillStyle = radial;\n  ctx.fillRect(0, 0, w, h);\n\n  // Top punch-slot cutout visual\n  ctx.fillStyle = \'#09090B\';\n  ctx.beginPath();\n  ctx.roundRect(w / 2 - 85, 34, 170, 26, 13);\n  ctx.fill();\n  ctx.strokeStyle = \'rgba(255,255,255,0.2)\';\n  ctx.lineWidth = 2;\n  ctx.stroke();\n\n  // Top-left & Top-right Corner Typography (matching reference video badge layout)\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.textAlign = \'left\';\n  ctx.font = \'800 32px \"Outfit\", sans-serif\';\n  ctx.fillText(\'MAHESA\', 60, 130);\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'600 18px \"JetBrains Mono\", monospace\';\n  ctx.fillText(\'ID \302\267 2026\', 60, 162);\n\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.textAlign = \'right\';\n  ctx.font = \'700 24px \"Outfit\", sans-serif\';\n  ctx.fillText(\'POLTEKKES\', w - 60, 128);\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'500 18px \"JetBrains Mono\", monospace\';\n  ctx.fillText(\'SEMARANG\', w - 60, 158);\n\n  // Background subtle \"PORTOFOLIO\" outline across middle of card\n  ctx.strokeStyle = \'rgba(255,255,255,0.12)\';\n  ctx.lineWidth = 3;\n  ctx.font = \'800 138px \"Outfit\", sans-serif\';\n  ctx.textAlign = \'center\';\n  ctx.strokeText(\'PORTOFOLIO\', w / 2, h * 0.46);\n\n  // 2. Full-Bleed Portrait of Mahesa\n  if (portraitImg && portraitImg.complete && portraitImg.naturalWidth > 0) {\n    const imgAspect = portraitImg.naturalWidth / portraitImg.naturalHeight;\n    const drawH = h * 0.78;\n    const drawW = drawH * imgAspect;\n    const drawX = w / 2 - drawW / 2;\n    const drawY = h * 0.16;\n    ctx.drawImage(portraitImg, drawX, drawY, drawW, drawH);\n  }\n\n  // 3. Bottom Dark Vignette Scrim for Signature & Name Overlay (matching reference video)\n  const bottomScrim = ctx.createLinearGradient(0, h * 0.56, 0, h);\n  bottomScrim.addColorStop(0, \'rgba(9,9,11,0)\');\n  bottomScrim.addColorStop(0.45, \'rgba(9,9,11,0.78)\');\n  bottomScrim.addColorStop(1, \'rgba(9,9,11,0.98)\');\n  ctx.fillStyle = bottomScrim;\n  ctx.fillRect(0, h * 0.56, w, h * 0.44);\n\n  // Stylized Signature / Display Script Overlay (\"Mahesa\")\n  ctx.save();\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.shadowColor = \'rgba(0,0,0,0.65)\';\n  ctx.shadowBlur = 16;\n  ctx.font = \'italic 700 118px Georgia, serif\';\n  ctx.textAlign = \'center\';\n  ctx.fillText(\'Mahesa\', w / 2, h - 255);\n  ctx.restore();\n\n  // Horizontal Accent Line under signature\n  ctx.strokeStyle = \'rgba(255,255,255,0.75)\';\n  ctx.lineWidth = 4;\n  ctx.beginPath();\n  ctx.moveTo(w / 2 - 150, h - 195);\n  ctx.lineTo(w / 2 + 150, h - 195);\n  ctx.stroke();\n\n  // Full Name & Role at bottom of card\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.textAlign = \'center\';\n  ctx.font = \'700 28px \"Outfit\", sans-serif\';\n  ctx.fillText(\'MAHESA RIZKY PUTRA I.\', w / 2, h - 140);\n\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'500 20px \"Plus Jakarta Sans\", sans-serif\';\n  ctx.fillText(\'Health Informatics & Digital Systems\', w / 2, h - 102);\n\n  // Bottom Corner Badges\n  ctx.fillStyle = \'#71717A\';\n  ctx.textAlign = \'left\';\n  ctx.font = \'500 17px \"JetBrains Mono\", monospace\';\n  ctx.fillText(\'NIM \302\267 P1337437123106\', 60, h - 46);\n\n  ctx.textAlign = \'right\';\n  ctx.fillText(\'PORTOFOLIO\', w - 60, h - 46);\n\n  // Outer subtle border on card face\n  ctx.strokeStyle = \'rgba(255,255,255,0.16)\';\n  ctx.lineWidth = 6;\n  ctx.strokeRect(3, 3, w - 6, h - 6);\n}\n\nfunction createCardBackTexture(maxAnisotropy: number): THREE.CanvasTexture {\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = 1024;\n  canvas.height = 1400;\n  const ctx = canvas.getContext(\'2d\')!;\n  const w = canvas.width;\n  const h = canvas.height;\n\n  ctx.fillStyle = \'#09090B\';\n  ctx.fillRect(0, 0, w, h);\n\n  ctx.strokeStyle = \'rgba(255,255,255,0.18)\';\n  ctx.lineWidth = 4;\n  ctx.beginPath();\n  ctx.roundRect(w / 2 - 130, 440, 260, 260, 38);\n  ctx.stroke();\n\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.font = \'italic 700 120px Georgia, serif\';\n  ctx.textAlign = \'center\';\n  ctx.textBaseline = \'middle\';\n  ctx.fillText(\'M\', w / 2, 570);\n\n  ctx.font = \'700 34px \"Outfit\", sans-serif\';\n  ctx.fillText(\'MAHESA RIZKY PUTRA I.\', w / 2, 790);\n\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'500 22px \"JetBrains Mono\", monospace\';\n  ctx.fillText(\'POLTEKKES KEMENKES SEMARANG\', w / 2, 845);\n\n  const tex = new THREE.CanvasTexture(canvas);\n  tex.colorSpace = THREE.SRGBColorSpace;\n  tex.anisotropy = maxAnisotropy;\n  tex.needsUpdate = true;\n  return tex;\n}\n\nexport const Lanyard3DCard: React.FC = () => {\n  const wrapperRef = useRef<HTMLDivElement | null>(null);\n  const canvasMountRef = useRef<HTMLDivElement | null>(null);\n  const physicsRef = useRef(createLanyardPhysicsState());\n  const [isHovered, setIsHovered] = useState(false);\n  const [isDragging, setIsDragging] = useState(false);\n\n  // Trigger top-down drop animation whenever the user scrolls into the About section\n  useEffect(() => {\n    const el = wrapperRef.current;\n    if (!el || typeof IntersectionObserver === \'undefined\') return;\n\n    const observer = new IntersectionObserver(\n      (entries) => {\n        for (const entry of entries) {\n          if (entry.isIntersecting) {\n            resetLanyardDrop(physicsRef.current);\n          }\n        }\n      },\n      { threshold: 0.15 }\n    );\n\n    observer.observe(el);\n    return () => observer.disconnect();\n  }, []);\n\n  useEffect(() => {\n    const container = canvasMountRef.current;\n    if (!container) return;\n\n    const isSoftwareGl = (() => {\n      const gl = document.createElement(\'canvas\').getContext(\'webgl2\');\n      if (!gl) return true;\n      const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\n      const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\n      const gpu = String(gl.getParameter(param));\n      gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\n      return /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\n    })();\n\n    const width = container.clientWidth || 560;\n    const height = container.clientHeight || 680;\n\n    const scene = new THREE.Scene();\n    const camera = new THREE.PerspectiveCamera(28, width / height, 0.1, 100);\n    camera.position.set(0, 0, 12.5);\n\n    const renderer = new THREE.WebGLRenderer({\n      antialias: !isSoftwareGl,\n      alpha: true,\n      powerPreference: \'high-performance\',\n    });\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 0.96;\n    renderer.setPixelRatio(\n      isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2)\n    );\n    renderer.setSize(width, height);\n\n    container.innerHTML = \'\';\n    container.appendChild(renderer.domElement);\n\n    // Studio Environment Map (RoomEnvironment)\n    const pmremGenerator = new THREE.PMREMGenerator(renderer);\n    const envTexture = pmremGenerator.fromScene(\n      new RoomEnvironment(),\n      0.04\n    ).texture;\n    scene.environment = envTexture;\n    scene.environmentIntensity = 0.55;\n    pmremGenerator.dispose();\n\n    // 3-Point Studio Lighting Rig\n    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x3f3f46, 0.9);\n    scene.add(hemiLight);\n\n    const keyLight = new THREE.DirectionalLight(0xfffbeb, 1.4);\n    keyLight.position.set(4, 6, 8);\n    scene.add(keyLight);\n\n    const rimLight = new THREE.DirectionalLight(0xe4e4e7, 1.1);\n    rimLight.position.set(-5, 3, -6);\n    scene.add(rimLight);\n\n    const maxAnisotropy = renderer.capabilities.getMaxAnisotropy();\n\n    // Procedural Textures\n    const frontCanvas = document.createElement(\'canvas\');\n    frontCanvas.width = 1024;\n    frontCanvas.height = 1400;\n    drawCardFrontCanvas(frontCanvas);\n\n    const frontTexture = new THREE.CanvasTexture(frontCanvas);\n    frontTexture.colorSpace = THREE.SRGBColorSpace;\n    frontTexture.anisotropy = maxAnisotropy;\n\n    const portraitImage = new Image();\n    portraitImage.crossOrigin = \'anonymous\';\n    portraitImage.onload = () => {\n      drawCardFrontCanvas(frontCanvas, portraitImage);\n      frontTexture.needsUpdate = true;\n    };\n    portraitImage.src = PROFILE_DATA.portraitSrc;\n\n    const backTexture = createCardBackTexture(maxAnisotropy);\n    const strapTexture = createLanyardStrapTexture(maxAnisotropy);\n\n    // Composite 3D Card & Metallic Clip Group\n    const cardGroup = new THREE.Group();\n    scene.add(cardGroup);\n\n    const cardW = 1.92;\n    const cardH = 2.66;\n    const cardDepth = 0.05;\n\n    const frameGeo = new THREE.BoxGeometry(\n      cardW + 0.06,\n      cardH + 0.06,\n      cardDepth\n    );\n    const frameMat = new THREE.MeshPhysicalMaterial({\n      color: 0x111113,\n      roughness: 0.25,\n      metalness: 0.4,\n      clearcoat: 0.85,\n    });\n    const frameMesh = new THREE.Mesh(frameGeo, frameMat);\n    cardGroup.add(frameMesh);\n\n    const faceGeo = new THREE.PlaneGeometry(cardW, cardH);\n    const frontMat = new THREE.MeshPhysicalMaterial({\n      map: frontTexture,\n      color: 0xffffff,\n      roughness: 0.2,\n      metalness: 0.1,\n      clearcoat: 1.0,\n      clearcoatRoughness: 0.12,\n    });\n    const frontMesh = new THREE.Mesh(faceGeo, frontMat);\n    frontMesh.position.z = cardDepth / 2 + 0.002;\n    cardGroup.add(frontMesh);\n\n    const backMat = new THREE.MeshPhysicalMaterial({\n      map: backTexture,\n      color: 0xffffff,\n      roughness: 0.28,\n      metalness: 0.2,\n      clearcoat: 0.9,\n      clearcoatRoughness: 0.15,\n    });\n    const backMesh = new THREE.Mesh(faceGeo, backMat);\n    backMesh.rotation.y = Math.PI;\n    backMesh.position.z = -(cardDepth / 2 + 0.002);\n    cardGroup.add(backMesh);\n\n    // Metallic Clip & Clamp Hardware\n    const metalMat = new THREE.MeshStandardMaterial({\n      color: 0xd4d4d8,\n      metalness: 0.92,\n      roughness: 0.2,\n    });\n    const darkMetalMat = new THREE.MeshStandardMaterial({\n      color: 0x18181b,\n      metalness: 0.85,\n      roughness: 0.28,\n    });\n\n    const tabGeo = new THREE.BoxGeometry(0.56, 0.16, 0.06);\n    const tabMesh = new THREE.Mesh(tabGeo, frameMat);\n    tabMesh.position.set(0, cardH / 2 + 0.08, 0);\n    cardGroup.add(tabMesh);\n\n    const clipJawGeo = new THREE.BoxGeometry(0.28, 0.24, 0.09);\n    const clipJawMesh = new THREE.Mesh(clipJawGeo, metalMat);\n    clipJawMesh.position.set(0, cardH / 2 + 0.16, 0);\n    cardGroup.add(clipJawMesh);\n\n    const ringGeo = new THREE.TorusGeometry(0.12, 0.028, 12, 24);\n    const ringMesh = new THREE.Mesh(ringGeo, metalMat);\n    ringMesh.position.set(0, cardH / 2 + 0.31, 0);\n    cardGroup.add(ringMesh);\n\n    const clampGeo = new THREE.BoxGeometry(0.4, 0.16, 0.08);\n    const clampMesh = new THREE.Mesh(clampGeo, darkMetalMat);\n    clampMesh.position.set(0, cardH / 2 + 0.44, 0);\n    cardGroup.add(clampMesh);\n\n    // Dynamic 3D Lanyard Ribbon Geometry\n    const ribbonSegments = 36;\n    const ribbonWidth = 0.36;\n    const ribbonGeo = new THREE.BufferGeometry();\n    const vertexCount = (ribbonSegments + 1) * 2;\n    const positions = new Float32Array(vertexCount * 3);\n    const uvs = new Float32Array(vertexCount * 2);\n    const indices: number[] = [];\n\n    for (let i = 0; i <= ribbonSegments; i++) {\n      const v = i / ribbonSegments;\n      uvs[i * 4 + 0] = v;\n      uvs[i * 4 + 1] = 0;\n      uvs[i * 4 + 2] = v;\n      uvs[i * 4 + 3] = 1;\n      if (i < ribbonSegments) {\n        const a = i * 2;\n        const b = i * 2 + 1;\n        const c = (i + 1) * 2;\n        const d = (i + 1) * 2 + 1;\n        indices.push(a, b, c, b, d, c);\n      }\n    }\n    ribbonGeo.setAttribute(\'position\', new THREE.BufferAttribute(positions, 3));\n    ribbonGeo.setAttribute(\'uv\', new THREE.BufferAttribute(uvs, 2));\n    ribbonGeo.setIndex(indices);\n\n    const ribbonMat = new THREE.MeshStandardMaterial({\n      map: strapTexture,\n      color: 0xffffff,\n      roughness: 0.65,\n      metalness: 0.1,\n      side: THREE.DoubleSide,\n    });\n    const ribbonMesh = new THREE.Mesh(ribbonGeo, ribbonMat);\n    ribbonMesh.frustumCulled = false;\n    scene.add(ribbonMesh);\n\n    const curvePoints = [\n      new THREE.Vector3(),\n      new THREE.Vector3(),\n      new THREE.Vector3(),\n      new THREE.Vector3(),\n    ];\n    const curve = new THREE.CatmullRomCurve3(curvePoints);\n    curve.curveType = \'chordal\';\n\n    const raycaster = new THREE.Raycaster();\n    const pointerNdc = new THREE.Vector2();\n    const unprojectedVec = new THREE.Vector3();\n    const rayDir = new THREE.Vector3();\n    const dragOffset = new THREE.Vector3();\n    const interactables = [frameMesh, frontMesh, backMesh];\n\n    const updateRibbonGeometry = () => {\n      const st = physicsRef.current;\n      const clampTopOffset = new THREE.Vector3(0, cardH / 2 + 0.48, 0);\n      clampTopOffset.applyEuler(cardGroup.rotation);\n      clampTopOffset.add(cardGroup.position);\n\n      curvePoints[0].copy(clampTopOffset);\n      curvePoints[1].set(\n        st.nodes[2].lerped.x,\n        st.nodes[2].lerped.y,\n        st.nodes[2].lerped.z\n      );\n      curvePoints[2].set(\n        st.nodes[1].lerped.x,\n        st.nodes[1].lerped.y,\n        st.nodes[1].lerped.z\n      );\n      curvePoints[3].set(\n        st.nodes[0].pos.x,\n        st.nodes[0].pos.y,\n        st.nodes[0].pos.z\n      );\n\n      const sampled = curve.getPoints(ribbonSegments);\n      const posAttr = ribbonGeo.getAttribute(\n        \'position\'\n      ) as THREE.BufferAttribute;\n\n      for (let i = 0; i <= ribbonSegments; i++) {\n        const pt = sampled[i];\n        const t = 1 - i / ribbonSegments;\n        const twistAngle = cardGroup.rotation.y * t * 0.5;\n        const halfW = ribbonWidth * 0.5;\n        const dx = Math.cos(twistAngle) * halfW;\n        const dz = Math.sin(twistAngle) * halfW;\n\n        posAttr.setXYZ(i * 2, pt.x - dx, pt.y, pt.z - dz);\n        posAttr.setXYZ(i * 2 + 1, pt.x + dx, pt.y, pt.z + dz);\n      }\n      posAttr.needsUpdate = true;\n      ribbonGeo.computeVertexNormals();\n    };\n\n    const getNdcFromEvent = (clientX: number, clientY: number) => {\n      const rect = renderer.domElement.getBoundingClientRect();\n      pointerNdc.x = ((clientX - rect.left) / rect.width) * 2 - 1;\n      pointerNdc.y = -((clientY - rect.top) / rect.height) * 2 + 1;\n    };\n\n    const projectPointerToCardPlane = (out: THREE.Vector3) => {\n      unprojectedVec.set(pointerNdc.x, pointerNdc.y, 0.5).unproject(camera);\n      rayDir.copy(unprojectedVec).sub(camera.position).normalize();\n      const dist = camera.position.length();\n      out.copy(camera.position).add(rayDir.multiplyScalar(dist));\n    };\n\n    const onPointerDown = (e: PointerEvent) => {\n      getNdcFromEvent(e.clientX, e.clientY);\n      raycaster.setFromCamera(pointerNdc, camera);\n      const hits = raycaster.intersectObjects(interactables, false);\n      if (hits.length > 0) {\n        const st = physicsRef.current;\n        st.isDragged = true;\n        setIsDragging(true);\n        const worldPt = new THREE.Vector3();\n        projectPointerToCardPlane(worldPt);\n        dragOffset.set(\n          worldPt.x - st.nodes[4].pos.x,\n          worldPt.y - st.nodes[4].pos.y,\n          worldPt.z - st.nodes[4].pos.z\n        );\n        st.dragTarget = { ...st.nodes[4].pos };\n        renderer.domElement.setPointerCapture(e.pointerId);\n      }\n    };\n\n    const onPointerMove = (e: PointerEvent) => {\n      getNdcFromEvent(e.clientX, e.clientY);\n      const st = physicsRef.current;\n      if (st.isDragged) {\n        const worldPt = new THREE.Vector3();\n        projectPointerToCardPlane(worldPt);\n        st.dragTarget = {\n          x: Math.max(-1.8, Math.min(1.8, worldPt.x - dragOffset.x)),\n          y: Math.max(-1.6, Math.min(2.2, worldPt.y - dragOffset.y)),\n          z: Math.max(-1.0, Math.min(1.0, worldPt.z - dragOffset.z)),\n        };\n        return;\n      }\n\n      raycaster.setFromCamera(pointerNdc, camera);\n      const hits = raycaster.intersectObjects(interactables, false);\n      setIsHovered(hits.length > 0);\n    };\n\n    const onPointerUp = (e: PointerEvent) => {\n      const st = physicsRef.current;\n      if (st.isDragged) {\n        st.isDragged = false;\n        setIsDragging(false);\n        try {\n          renderer.domElement.releasePointerCapture(e.pointerId);\n        } catch {\n          // ignore if not captured\n        }\n      }\n    };\n\n    const domEl = renderer.domElement;\n    domEl.addEventListener(\'pointerdown\', onPointerDown);\n    domEl.addEventListener(\'pointermove\', onPointerMove);\n    window.addEventListener(\'pointerup\', onPointerUp);\n\n    const onResize = () => {\n      if (!container) return;\n      const newW = container.clientWidth || 560;\n      const newH = container.clientHeight || 680;\n      camera.aspect = newW / newH;\n      camera.updateProjectionMatrix();\n      renderer.setSize(newW, newH);\n    };\n    window.addEventListener(\'resize\', onResize);\n\n    if (!isSoftwareGl) {\n      renderer.compile(scene, camera);\n    }\n\n    let frameId = 0;\n    let disposed = false;\n    let lastTime = performance.now();\n\n    function afterDraw(cb: () => void) {\n      const gl = renderer.getContext() as WebGL2RenderingContext;\n      const sync = gl.fenceSync\n        ? gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0)\n        : null;\n      gl.flush();\n      const poll = () => {\n        if (disposed) return;\n        const state = sync && gl.getSyncParameter(sync, gl.SYNC_STATUS);\n        if (state === gl.UNSIGNALED) {\n          frameId = window.setTimeout(poll, 5);\n        } else {\n          if (sync) gl.deleteSync(sync);\n          frameId = window.setTimeout(cb, 80);\n        }\n      };\n      frameId = window.setTimeout(poll, 5);\n    }\n\n    function tick() {\n      if (disposed) return;\n      const now = performance.now();\n      const elapsed = Math.min((now - lastTime) / 1000, 0.14);\n      lastTime = now;\n\n      const st = physicsRef.current;\n      const subSteps = Math.max(1, Math.ceil(elapsed / 0.018));\n      const subDt = elapsed / subSteps;\n      for (let s = 0; s < subSteps; s++) {\n        stepLanyardPhysics(st, subDt);\n      }\n\n      cardGroup.position.set(\n        st.nodes[4].pos.x,\n        st.nodes[4].pos.y - (cardH / 2 + 0.18),\n        st.nodes[4].pos.z\n      );\n      cardGroup.rotation.set(st.rot.x, st.rot.y, st.rot.z);\n\n      updateRibbonGeometry();\n      renderer.render(scene, camera);\n\n      if (isSoftwareGl) {\n        afterDraw(tick);\n      } else {\n        frameId = requestAnimationFrame(tick);\n      }\n    }\n\n    tick();\n\n    return () => {\n      disposed = true;\n      cancelAnimationFrame(frameId);\n      clearTimeout(frameId);\n      domEl.removeEventListener(\'pointerdown\', onPointerDown);\n      domEl.removeEventListener(\'pointermove\', onPointerMove);\n      window.removeEventListener(\'pointerup\', onPointerUp);\n      window.removeEventListener(\'resize\', onResize);\n\n      frontTexture.dispose();\n      backTexture.dispose();\n      strapTexture.dispose();\n      envTexture.dispose();\n      frameGeo.dispose();\n      faceGeo.dispose();\n      tabGeo.dispose();\n      clipJawGeo.dispose();\n      ringGeo.dispose();\n      clampGeo.dispose();\n      ribbonGeo.dispose();\n      frameMat.dispose();\n      frontMat.dispose();\n      backMat.dispose();\n      metalMat.dispose();\n      darkMetalMat.dispose();\n      ribbonMat.dispose();\n      renderer.dispose();\n    };\n  }, []);\n\n  return (\n    <div\n      ref={wrapperRef}\n      className=\"relative w-[calc(100%+4rem)] -mx-8 sm:w-[calc(100%+8rem)] sm:-mx-16 h-[560px] sm:h-[620px] lg:h-[680px] overflow-visible flex items-start justify-center\"\n    >\n      <div\n        ref={canvasMountRef}\n        data-testid=\"lanyard-3d-canvas\"\n        className={`w-full h-full select-none ${\n          isDragging\n            ? \'cursor-grabbing\'\n            : isHovered\n              ? \'cursor-grab\'\n              : \'cursor-default\'\n        }`}\n      />\n    </div>\n  );\n};"
        replacement_content: "import React, { useEffect, useRef, useState } from \'react\';\nimport * as THREE from \'three\';\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\nimport { PROFILE_DATA } from \'../data/portfolioData\';\nimport {\n  createLanyardPhysicsState,\n  resetLanyardDrop,\n  setLanyardAnchorX,\n  stepLanyardPhysics,\n} from \'../utils/lanyardPhysics\';\n\nfunction computeWorldAnchorX(width: number, height: number): number {\n  if (width < 1024) return 0;\n  const visibleHeight = 2 * 12.5 * Math.tan((28 * Math.PI) / 360);\n  const visibleWidth = visibleHeight * (width / height);\n  const contentWidth = Math.min(width - 64, 1160);\n  const rightColCenterOffsetPx = contentWidth * 0.29;\n  return (rightColCenterOffsetPx / width) * visibleWidth;\n}\n\nfunction createLanyardStrapTexture(maxAnisotropy: number): THREE.CanvasTexture {\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = 1024;\n  canvas.height = 128;\n  const ctx = canvas.getContext(\'2d\')!;\n\n  // Matte jet-black strap background\n  ctx.fillStyle = \'#09090B\';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n  // Subtle woven nylon texture lines\n  ctx.strokeStyle = \'rgba(255,255,255,0.06)\';\n  ctx.lineWidth = 2;\n  for (let x = 0; x < canvas.width; x += 8) {\n    ctx.beginPath();\n    ctx.moveTo(x, 0);\n    ctx.lineTo(x, canvas.height);\n    ctx.stroke();\n  }\n\n  // Repeating \"MAHESA\" print along the strap matching reference video\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.font = \'800 44px \"Outfit\", sans-serif\';\n  ctx.textAlign = \'center\';\n  ctx.textBaseline = \'middle\';\n  ctx.fillText(\n    \'MAHESA      \342\230\205      MAHESA      \342\230\205\',\n    canvas.width / 2,\n    canvas.height / 2 + 2\n  );\n\n  const texture = new THREE.CanvasTexture(canvas);\n  texture.colorSpace = THREE.SRGBColorSpace;\n  texture.wrapS = THREE.RepeatWrapping;\n  texture.wrapT = THREE.RepeatWrapping;\n  texture.repeat.set(3, 1);\n  texture.anisotropy = maxAnisotropy;\n  texture.needsUpdate = true;\n  return texture;\n}\n\nfunction drawCardFrontCanvas(\n  canvas: HTMLCanvasElement,\n  portraitImg?: HTMLImageElement\n) {\n  const ctx = canvas.getContext(\'2d\')!;\n  const w = canvas.width;\n  const h = canvas.height;\n\n  // 1. Sleek Monochrome Studio Backdrop (like the reference video badge)\n  const bgGrad = ctx.createLinearGradient(0, 0, 0, h);\n  bgGrad.addColorStop(0, \'#27272A\');\n  bgGrad.addColorStop(0.55, \'#18181B\');\n  bgGrad.addColorStop(1, \'#09090B\');\n  ctx.fillStyle = bgGrad;\n  ctx.fillRect(0, 0, w, h);\n\n  // Subtle radial studio spotlight behind the subject\n  const radial = ctx.createRadialGradient(\n    w / 2,\n    h * 0.44,\n    50,\n    w / 2,\n    h * 0.44,\n    w * 0.65\n  );\n  radial.addColorStop(0, \'rgba(255,255,255,0.22)\');\n  radial.addColorStop(1, \'rgba(0,0,0,0)\');\n  ctx.fillStyle = radial;\n  ctx.fillRect(0, 0, w, h);\n\n  // Top punch-slot cutout visual\n  ctx.fillStyle = \'#09090B\';\n  ctx.beginPath();\n  ctx.roundRect(w / 2 - 85, 34, 170, 26, 13);\n  ctx.fill();\n  ctx.strokeStyle = \'rgba(255,255,255,0.2)\';\n  ctx.lineWidth = 2;\n  ctx.stroke();\n\n  // Top-left & Top-right Corner Typography (matching reference video badge layout)\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.textAlign = \'left\';\n  ctx.font = \'800 32px \"Outfit\", sans-serif\';\n  ctx.fillText(\'MAHESA\', 60, 130);\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'600 18px \"JetBrains Mono\", monospace\';\n  ctx.fillText(\'ID \302\267 2026\', 60, 162);\n\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.textAlign = \'right\';\n  ctx.font = \'700 24px \"Outfit\", sans-serif\';\n  ctx.fillText(\'POLTEKKES\', w - 60, 128);\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'500 18px \"JetBrains Mono\", monospace\';\n  ctx.fillText(\'SEMARANG\', w - 60, 158);\n\n  // Background subtle \"PORTOFOLIO\" outline across middle of card\n  ctx.strokeStyle = \'rgba(255,255,255,0.12)\';\n  ctx.lineWidth = 3;\n  ctx.font = \'800 138px \"Outfit\", sans-serif\';\n  ctx.textAlign = \'center\';\n  ctx.strokeText(\'PORTOFOLIO\', w / 2, h * 0.46);\n\n  // 2. Full-Bleed Portrait of Mahesa\n  if (portraitImg && portraitImg.complete && portraitImg.naturalWidth > 0) {\n    const imgAspect = portraitImg.naturalWidth / portraitImg.naturalHeight;\n    const drawH = h * 0.78;\n    const drawW = drawH * imgAspect;\n    const drawX = w / 2 - drawW / 2;\n    const drawY = h * 0.16;\n    ctx.drawImage(portraitImg, drawX, drawY, drawW, drawH);\n  }\n\n  // 3. Bottom Dark Vignette Scrim for Signature & Role Overlay\n  const bottomScrim = ctx.createLinearGradient(0, h * 0.56, 0, h);\n  bottomScrim.addColorStop(0, \'rgba(9,9,11,0)\');\n  bottomScrim.addColorStop(0.45, \'rgba(9,9,11,0.78)\');\n  bottomScrim.addColorStop(1, \'rgba(9,9,11,0.98)\');\n  ctx.fillStyle = bottomScrim;\n  ctx.fillRect(0, h * 0.56, w, h * 0.44);\n\n  // Stylized Signature / Display Script Overlay (\"Mahesa\")\n  ctx.save();\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.shadowColor = \'rgba(0,0,0,0.65)\';\n  ctx.shadowBlur = 16;\n  ctx.font = \'italic 700 118px Georgia, serif\';\n  ctx.textAlign = \'center\';\n  ctx.fillText(\'Mahesa\', w / 2, h - 225);\n  ctx.restore();\n\n  // Horizontal Accent Line under signature\n  ctx.strokeStyle = \'rgba(255,255,255,0.75)\';\n  ctx.lineWidth = 4;\n  ctx.beginPath();\n  ctx.moveTo(w / 2 - 150, h - 168);\n  ctx.lineTo(w / 2 + 150, h - 168);\n  ctx.stroke();\n\n  // Label requested by user: \"Perekam Medis dan Informasi Kesehatan\" with nothing below it\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.textAlign = \'center\';\n  ctx.font = \'700 27px \"Outfit\", sans-serif\';\n  ctx.fillText(\'Perekam Medis dan Informasi Kesehatan\', w / 2, h - 112);\n\n  // Outer subtle border on card face\n  ctx.strokeStyle = \'rgba(255,255,255,0.16)\';\n  ctx.lineWidth = 6;\n  ctx.strokeRect(3, 3, w - 6, h - 6);\n}\n\nfunction createCardBackTexture(maxAnisotropy: number): THREE.CanvasTexture {\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = 1024;\n  canvas.height = 1400;\n  const ctx = canvas.getContext(\'2d\')!;\n  const w = canvas.width;\n  const h = canvas.height;\n\n  ctx.fillStyle = \'#09090B\';\n  ctx.fillRect(0, 0, w, h);\n\n  ctx.strokeStyle = \'rgba(255,255,255,0.18)\';\n  ctx.lineWidth = 4;\n  ctx.beginPath();\n  ctx.roundRect(w / 2 - 130, 440, 260, 260, 38);\n  ctx.stroke();\n\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.font = \'italic 700 120px Georgia, serif\';\n  ctx.textAlign = \'center\';\n  ctx.textBaseline = \'middle\';\n  ctx.fillText(\'M\', w / 2, 570);\n\n  ctx.font = \'700 30px \"Outfit\", sans-serif\';\n  ctx.fillText(\'Perekam Medis dan Informasi Kesehatan\', w / 2, 795);\n\n  const tex = new THREE.CanvasTexture(canvas);\n  tex.colorSpace = THREE.SRGBColorSpace;\n  tex.anisotropy = maxAnisotropy;\n  tex.needsUpdate = true;\n  return tex;\n}\n\nexport const Lanyard3DCard: React.FC = () => {\n  const wrapperRef = useRef<HTMLDivElement | null>(null);\n  const canvasMountRef = useRef<HTMLDivElement | null>(null);\n  const physicsRef = useRef(createLanyardPhysicsState(2.2));\n  const [isHovered, setIsHovered] = useState(false);\n  const [isDragging, setIsDragging] = useState(false);\n\n  // Trigger top-down drop animation whenever the user scrolls into the About section\n  useEffect(() => {\n    const el = wrapperRef.current;\n    if (!el || typeof IntersectionObserver === \'undefined\') return;\n\n    const observer = new IntersectionObserver(\n      (entries) => {\n        for (const entry of entries) {\n          if (entry.isIntersecting) {\n            resetLanyardDrop(physicsRef.current);\n          }\n        }\n      },\n      { threshold: 0.15 }\n    );\n\n    observer.observe(el);\n    return () => observer.disconnect();\n  }, []);\n\n  useEffect(() => {\n    const container = canvasMountRef.current;\n    if (!container) return;\n\n    const isSoftwareGl = (() => {\n      const gl = document.createElement(\'canvas\').getContext(\'webgl2\');\n      if (!gl) return true;\n      const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\n      const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\n      const gpu = String(gl.getParameter(param));\n      gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\n      return /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\n    })();\n\n    const width = container.clientWidth || window.innerWidth || 1280;\n    const height = container.clientHeight || 760;\n\n    setLanyardAnchorX(physicsRef.current, computeWorldAnchorX(width, height));\n\n    const scene = new THREE.Scene();\n    const camera = new THREE.PerspectiveCamera(28, width / height, 0.1, 100);\n    camera.position.set(0, 0, 12.5);\n\n    const renderer = new THREE.WebGLRenderer({\n      antialias: !isSoftwareGl,\n      alpha: true,\n      powerPreference: \'high-performance\',\n    });\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 0.96;\n    renderer.setPixelRatio(\n      isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2)\n    );\n    renderer.setSize(width, height);\n    renderer.domElement.style.pointerEvents = \'none\';\n\n    container.innerHTML = \'\';\n    container.appendChild(renderer.domElement);\n\n    // Studio Environment Map (RoomEnvironment)\n    const pmremGenerator = new THREE.PMREMGenerator(renderer);\n    const envTexture = pmremGenerator.fromScene(\n      new RoomEnvironment(),\n      0.04\n    ).texture;\n    scene.environment = envTexture;\n    scene.environmentIntensity = 0.55;\n    pmremGenerator.dispose();\n\n    // 3-Point Studio Lighting Rig\n    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x3f3f46, 0.9);\n    scene.add(hemiLight);\n\n    const keyLight = new THREE.DirectionalLight(0xfffbeb, 1.4);\n    keyLight.position.set(4, 6, 8);\n    scene.add(keyLight);\n\n    const rimLight = new THREE.DirectionalLight(0xe4e4e7, 1.1);\n    rimLight.position.set(-5, 3, -6);\n    scene.add(rimLight);\n\n    const maxAnisotropy = renderer.capabilities.getMaxAnisotropy();\n\n    // Procedural Textures\n    const frontCanvas = document.createElement(\'canvas\');\n    frontCanvas.width = 1024;\n    frontCanvas.height = 1400;\n    drawCardFrontCanvas(frontCanvas);\n\n    const frontTexture = new THREE.CanvasTexture(frontCanvas);\n    frontTexture.colorSpace = THREE.SRGBColorSpace;\n    frontTexture.anisotropy = maxAnisotropy;\n\n    const portraitImage = new Image();\n    portraitImage.crossOrigin = \'anonymous\';\n    portraitImage.onload = () => {\n      drawCardFrontCanvas(frontCanvas, portraitImage);\n      frontTexture.needsUpdate = true;\n    };\n    portraitImage.src = PROFILE_DATA.portraitSrc;\n\n    const backTexture = createCardBackTexture(maxAnisotropy);\n    const strapTexture = createLanyardStrapTexture(maxAnisotropy);\n\n    // Composite 3D Card & Metallic Clip Group\n    const cardGroup = new THREE.Group();\n    scene.add(cardGroup);\n\n    const cardW = 1.92;\n    const cardH = 2.66;\n    const cardDepth = 0.05;\n\n    const frameGeo = new THREE.BoxGeometry(\n      cardW + 0.06,\n      cardH + 0.06,\n      cardDepth\n    );\n    const frameMat = new THREE.MeshPhysicalMaterial({\n      color: 0x111113,\n      roughness: 0.25,\n      metalness: 0.4,\n      clearcoat: 0.85,\n    });\n    const frameMesh = new THREE.Mesh(frameGeo, frameMat);\n    cardGroup.add(frameMesh);\n\n    const faceGeo = new THREE.PlaneGeometry(cardW, cardH);\n    const frontMat = new THREE.MeshPhysicalMaterial({\n      map: frontTexture,\n      color: 0xffffff,\n      roughness: 0.2,\n      metalness: 0.1,\n      clearcoat: 1.0,\n      clearcoatRoughness: 0.12,\n    });\n    const frontMesh = new THREE.Mesh(faceGeo, frontMat);\n    frontMesh.position.z = cardDepth / 2 + 0.002;\n    cardGroup.add(frontMesh);\n\n    const backMat = new THREE.MeshPhysicalMaterial({\n      map: backTexture,\n      color: 0xffffff,\n      roughness: 0.28,\n      metalness: 0.2,\n      clearcoat: 0.9,\n      clearcoatRoughness: 0.15,\n    });\n    const backMesh = new THREE.Mesh(faceGeo, backMat);\n    backMesh.rotation.y = Math.PI;\n    backMesh.position.z = -(cardDepth / 2 + 0.002);\n    cardGroup.add(backMesh);\n\n    // Metallic Clip & Clamp Hardware\n    const metalMat = new THREE.MeshStandardMaterial({\n      color: 0xd4d4d8,\n      metalness: 0.92,\n      roughness: 0.2,\n    });\n    const darkMetalMat = new THREE.MeshStandardMaterial({\n      color: 0x18181b,\n      metalness: 0.85,\n      roughness: 0.28,\n    });\n\n    const tabGeo = new THREE.BoxGeometry(0.56, 0.16, 0.06);\n    const tabMesh = new THREE.Mesh(tabGeo, frameMat);\n    tabMesh.position.set(0, cardH / 2 + 0.08, 0);\n    cardGroup.add(tabMesh);\n\n    const clipJawGeo = new THREE.BoxGeometry(0.28, 0.24, 0.09);\n    const clipJawMesh = new THREE.Mesh(clipJawGeo, metalMat);\n    clipJawMesh.position.set(0, cardH / 2 + 0.16, 0);\n    cardGroup.add(clipJawMesh);\n\n    const ringGeo = new THREE.TorusGeometry(0.12, 0.028, 12, 24);\n    const ringMesh = new THREE.Mesh(ringGeo, metalMat);\n    ringMesh.position.set(0, cardH / 2 + 0.31, 0);\n    cardGroup.add(ringMesh);\n\n    const clampGeo = new THREE.BoxGeometry(0.4, 0.16, 0.08);\n    const clampMesh = new THREE.Mesh(clampGeo, darkMetalMat);\n    clampMesh.position.set(0, cardH / 2 + 0.44, 0);\n    cardGroup.add(clampMesh);\n\n    // Dynamic 3D Lanyard Ribbon Geometry\n    const ribbonSegments = 36;\n    const ribbonWidth = 0.36;\n    const ribbonGeo = new THREE.BufferGeometry();\n    const vertexCount = (ribbonSegments + 1) * 2;\n    const positions = new Float32Array(vertexCount * 3);\n    const uvs = new Float32Array(vertexCount * 2);\n    const indices: number[] = [];\n\n    for (let i = 0; i <= ribbonSegments; i++) {\n      const v = i / ribbonSegments;\n      uvs[i * 4 + 0] = v;\n      uvs[i * 4 + 1] = 0;\n      uvs[i * 4 + 2] = v;\n      uvs[i * 4 + 3] = 1;\n      if (i < ribbonSegments) {\n        const a = i * 2;\n        const b = i * 2 + 1;\n        const c = (i + 1) * 2;\n        const d = (i + 1) * 2 + 1;\n        indices.push(a, b, c, b, d, c);\n      }\n    }\n    ribbonGeo.setAttribute(\'position\', new THREE.BufferAttribute(positions, 3));\n    ribbonGeo.setAttribute(\'uv\', new THREE.BufferAttribute(uvs, 2));\n    ribbonGeo.setIndex(indices);\n\n    const ribbonMat = new THREE.MeshStandardMaterial({\n      map: strapTexture,\n      color: 0xffffff,\n      roughness: 0.65,\n      metalness: 0.1,\n      side: THREE.DoubleSide,\n    });\n    const ribbonMesh = new THREE.Mesh(ribbonGeo, ribbonMat);\n    ribbonMesh.frustumCulled = false;\n    scene.add(ribbonMesh);\n\n    const curvePoints = [\n      new THREE.Vector3(),\n      new THREE.Vector3(),\n      new THREE.Vector3(),\n      new THREE.Vector3(),\n    ];\n    const curve = new THREE.CatmullRomCurve3(curvePoints);\n    curve.curveType = \'chordal\';\n\n    const raycaster = new THREE.Raycaster();\n    const pointerNdc = new THREE.Vector2();\n    const unprojectedVec = new THREE.Vector3();\n    const rayDir = new THREE.Vector3();\n    const dragOffset = new THREE.Vector3();\n    const interactables = [frameMesh, frontMesh, backMesh];\n\n    const updateRibbonGeometry = () => {\n      const st = physicsRef.current;\n      const clampTopOffset = new THREE.Vector3(0, cardH / 2 + 0.48, 0);\n      clampTopOffset.applyEuler(cardGroup.rotation);\n      clampTopOffset.add(cardGroup.position);\n\n      curvePoints[0].copy(clampTopOffset);\n      curvePoints[1].set(\n        st.nodes[2].lerped.x,\n        st.nodes[2].lerped.y,\n        st.nodes[2].lerped.z\n      );\n      curvePoints[2].set(\n        st.nodes[1].lerped.x,\n        st.nodes[1].lerped.y,\n        st.nodes[1].lerped.z\n      );\n      curvePoints[3].set(\n        st.nodes[0].pos.x,\n        st.nodes[0].pos.y,\n        st.nodes[0].pos.z\n      );\n\n      const sampled = curve.getPoints(ribbonSegments);\n      const posAttr = ribbonGeo.getAttribute(\n        \'position\'\n      ) as THREE.BufferAttribute;\n\n      for (let i = 0; i <= ribbonSegments; i++) {\n        const pt = sampled[i];\n        const t = 1 - i / ribbonSegments;\n        const twistAngle = cardGroup.rotation.y * t * 0.5;\n        const halfW = ribbonWidth * 0.5;\n        const dx = Math.cos(twistAngle) * halfW;\n        const dz = Math.sin(twistAngle) * halfW;\n\n        posAttr.setXYZ(i * 2, pt.x - dx, pt.y, pt.z - dz);\n        posAttr.setXYZ(i * 2 + 1, pt.x + dx, pt.y, pt.z + dz);\n      }\n      posAttr.needsUpdate = true;\n      ribbonGeo.computeVertexNormals();\n    };\n\n    const getNdcFromEvent = (clientX: number, clientY: number): boolean => {\n      const rect = renderer.domElement.getBoundingClientRect();\n      if (rect.width === 0 || rect.height === 0) return false;\n      pointerNdc.x = ((clientX - rect.left) / rect.width) * 2 - 1;\n      pointerNdc.y = -((clientY - rect.top) / rect.height) * 2 + 1;\n      return (\n        clientX >= rect.left &&\n        clientX <= rect.right &&\n        clientY >= rect.top &&\n        clientY <= rect.bottom\n      );\n    };\n\n    const projectPointerToCardPlane = (out: THREE.Vector3) => {\n      unprojectedVec.set(pointerNdc.x, pointerNdc.y, 0.5).unproject(camera);\n      rayDir.copy(unprojectedVec).sub(camera.position).normalize();\n      const dist = camera.position.z / Math.max(0.001, -rayDir.z);\n      out.copy(camera.position).add(rayDir.multiplyScalar(dist));\n    };\n\n    const onPointerDown = (e: PointerEvent) => {\n      if (!getNdcFromEvent(e.clientX, e.clientY)) return;\n      raycaster.setFromCamera(pointerNdc, camera);\n      const hits = raycaster.intersectObjects(interactables, false);\n      if (hits.length > 0) {\n        e.preventDefault();\n        const st = physicsRef.current;\n        st.isDragged = true;\n        setIsDragging(true);\n        renderer.domElement.style.pointerEvents = \'auto\';\n        renderer.domElement.style.cursor = \'grabbing\';\n        const worldPt = new THREE.Vector3();\n        projectPointerToCardPlane(worldPt);\n        dragOffset.set(\n          worldPt.x - st.nodes[4].pos.x,\n          worldPt.y - st.nodes[4].pos.y,\n          worldPt.z - st.nodes[4].pos.z\n        );\n        st.dragTarget = { ...st.nodes[4].pos };\n      }\n    };\n\n    const onPointerMove = (e: PointerEvent) => {\n      const inBounds = getNdcFromEvent(e.clientX, e.clientY);\n      const st = physicsRef.current;\n      if (st.isDragged) {\n        const worldPt = new THREE.Vector3();\n        projectPointerToCardPlane(worldPt);\n        st.dragTarget = {\n          x: Math.max(-5.5, Math.min(5.5, worldPt.x - dragOffset.x)),\n          y: Math.max(-2.6, Math.min(2.6, worldPt.y - dragOffset.y)),\n          z: Math.max(-1.0, Math.min(1.0, worldPt.z - dragOffset.z)),\n        };\n        return;\n      }\n\n      if (!inBounds) {\n        setIsHovered(false);\n        renderer.domElement.style.pointerEvents = \'none\';\n        renderer.domElement.style.cursor = \'default\';\n        return;\n      }\n\n      raycaster.setFromCamera(pointerNdc, camera);\n      const hits = raycaster.intersectObjects(interactables, false);\n      const hovered = hits.length > 0;\n      setIsHovered(hovered);\n      renderer.domElement.style.pointerEvents = hovered ? \'auto\' : \'none\';\n      renderer.domElement.style.cursor = hovered ? \'grab\' : \'default\';\n    };\n\n    const onPointerUp = () => {\n      const st = physicsRef.current;\n      if (st.isDragged) {\n        st.isDragged = false;\n        setIsDragging(false);\n        renderer.domElement.style.pointerEvents = \'none\';\n        renderer.domElement.style.cursor = \'default\';\n      }\n    };\n\n    window.addEventListener(\'pointerdown\', onPointerDown, { passive: false });\n    window.addEventListener(\'pointermove\', onPointerMove);\n    window.addEventListener(\'pointerup\', onPointerUp);\n\n    const onResize = () => {\n      if (!container) return;\n      const newW = container.clientWidth || window.innerWidth || 1280;\n      const newH = container.clientHeight || 760;\n      setLanyardAnchorX(physicsRef.current, computeWorldAnchorX(newW, newH));\n      camera.aspect = newW / newH;\n      camera.updateProjectionMatrix();\n      renderer.setSize(newW, newH);\n    };\n    window.addEventListener(\'resize\', onResize);\n\n    if (!isSoftwareGl) {\n      renderer.compile(scene, camera);\n    }\n\n    let frameId = 0;\n    let disposed = false;\n    let lastTime = performance.now();\n\n    function afterDraw(cb: () => void) {\n      const gl = renderer.getContext() as WebGL2RenderingContext;\n      const sync = gl.fenceSync\n        ? gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0)\n        : null;\n      gl.flush();\n      const poll = () => {\n        if (disposed) return;\n        const state = sync && gl.getSyncParameter(sync, gl.SYNC_STATUS);\n        if (state === gl.UNSIGNALED) {\n          frameId = window.setTimeout(poll, 5);\n        } else {\n          if (sync) gl.deleteSync(sync);\n          frameId = window.setTimeout(cb, 80);\n        }\n      };\n      frameId = window.setTimeout(poll, 5);\n    }\n\n    function tick() {\n      if (disposed) return;\n      const now = performance.now();\n      const elapsed = Math.min((now - lastTime) / 1000, 0.14);\n      lastTime = now;\n\n      const st = physicsRef.current;\n      const subSteps = Math.max(1, Math.ceil(elapsed / 0.018));\n      const subDt = elapsed / subSteps;\n      for (let s = 0; s < subSteps; s++) {\n        stepLanyardPhysics(st, subDt);\n      }\n\n      cardGroup.position.set(\n        st.nodes[4].pos.x,\n        st.nodes[4].pos.y - (cardH / 2 + 0.18),\n        st.nodes[4].pos.z\n      );\n      cardGroup.rotation.set(st.rot.x, st.rot.y, st.rot.z);\n\n      updateRibbonGeometry();\n      renderer.render(scene, camera);\n\n      if (isSoftwareGl) {\n        afterDraw(tick);\n      } else {\n        frameId = requestAnimationFrame(tick);\n      }\n    }\n\n    tick();\n\n    return () => {\n      disposed = true;\n      cancelAnimationFrame(frameId);\n      clearTimeout(frameId);\n      window.removeEventListener(\'pointerdown\', onPointerDown);\n      window.removeEventListener(\'pointermove\', onPointerMove);\n      window.removeEventListener(\'pointerup\', onPointerUp);\n      window.removeEventListener(\'resize\', onResize);\n\n      frontTexture.dispose();\n      backTexture.dispose();\n      strapTexture.dispose();\n      envTexture.dispose();\n      frameGeo.dispose();\n      faceGeo.dispose();\n      tabGeo.dispose();\n      clipJawGeo.dispose();\n      ringGeo.dispose();\n      clampGeo.dispose();\n      ribbonGeo.dispose();\n      frameMat.dispose();\n      frontMat.dispose();\n      backMat.dispose();\n      metalMat.dispose();\n      darkMetalMat.dispose();\n      ribbonMat.dispose();\n      renderer.dispose();\n    };\n  }, []);\n\n  return (\n    <div\n      ref={wrapperRef}\n      className=\"relative w-full h-[580px] sm:h-[640px] lg:h-[760px] pointer-events-none overflow-visible flex items-start justify-center\"\n    >\n      <div\n        ref={canvasMountRef}\n        data-testid=\"lanyard-3d-canvas\"\n        className={`w-full h-full select-none pointer-events-none ${\n          isDragging\n            ? \'cursor-grabbing\'\n            : isHovered\n              ? \'cursor-grab\'\n              : \'cursor-default\'\n        }`}\n      />\n    </div>\n  );\n};"
