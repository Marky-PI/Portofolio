              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  state.rot.x += (targetRotX - state.rot.x) * Math.min(1, safeDt * 12);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
