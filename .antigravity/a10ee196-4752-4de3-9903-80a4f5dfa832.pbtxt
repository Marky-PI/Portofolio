            }
            lines {
              text: "        st.nodes[0].pos.x,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        st.nodes[0].pos.y,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        st.nodes[0].pos.z"
