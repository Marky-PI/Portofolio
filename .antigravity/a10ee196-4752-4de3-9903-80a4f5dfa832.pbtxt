  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { ArrowUpRight, FileText, MapPin, X } from \'lucide-react\';\nimport { PROFILE_DATA, type NavSectionId } from \'../data/portfolioData\';\n\ninterface AboutSectionProps {\n  darkMode: boolean;\n  onNavigate: (sectionId: NavSectionId) => void;\n}\n\nexport const AboutSection: React.FC<AboutSectionProps> = ({\n  darkMode,\n  onNavigate,\n}) => {\n  const [cvModalOpen, setCvModalOpen] = useState(false);\n\n  return (\n    <section\n      id=\"about\"\n      aria-labelledby=\"about-heading\"\n      className={`py-24 sm:py-32 px-4 sm:px-8 border-t transition-colors duration-300 ${\n        darkMode\n          ? \'bg-[#0F0F12] border-white/10 text-zinc-100\'\n          : \'bg-[#F4F4F5] border-zinc-900/10 text-zinc-900\'\n      }`}\n    >\n      <div className=\"max-w-[1160px] mx-auto\">\n        {/* Section Editorial Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 pb-12 border-b border-current/10\">\n          <div>\n            <p className=\"font-mono text-xs tracking-[0.18em] uppercase opacity-60\">\n              01 \302\267 Profil & Latar Belakang\n            </p>\n            <h2\n              id=\"about-heading\"\n              className=\"font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight mt-2 text-balance\"\n            >\n              Dedikasi pada Presisi Data & Eksekusi Digital.\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-2 text-xs opacity-75 font-mono shrink-0\">\n            <MapPin className=\"w-3.5 h-3.5\" />\n            <span>{PROFILE_DATA.location}</span>\n          </div>\n        </div>\n\n        {/* 2-Column Editorial Split */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 pt-12 items-stretch\">\n          {/* Left Column: Narrative & CTA */}\n          <div className=\"lg:col-span-7 flex flex-col justify-between space-y-6\">\n            <div className=\"space-y-5\">\n              <p className=\"font-display text-xl sm:text-2xl font-medium leading-snug tracking-tight\">\n                {PROFILE_DATA.bioLead}\n              </p>\n              {PROFILE_DATA.bioParagraphs.map((paragraph, index) => (\n                <p\n                  key={index}\n                  className={`text-sm sm:text-base leading-relaxed ${\n                    darkMode ? \'text-zinc-300\' : \'text-zinc-600\'\n                  }`}\n                >\n                  {paragraph}\n                </p>\n              ))}\n            </div>\n\n            <div className=\"pt-4 flex flex-wrap items-center gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => setCvModalOpen(true)}\n                className={`inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-semibold tracking-wide transition-all cursor-pointer whitespace-nowrap shrink-0 ${\n                  darkMode\n                    ? \'bg-white text-zinc-950 hover:bg-zinc-200\'\n                    : \'bg-zinc-950 text-white hover:bg-zinc-800\'\n                }`}\n              >\n                <FileText className=\"w-4 h-4\" />\n                <span>Ringkasan Curriculum Vitae</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'projects\')}\n                className={`inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-semibold tracking-wide border transition-all cursor-pointer whitespace-nowrap shrink-0 ${\n                  darkMode\n                    ? \'border-white/20 text-zinc-100 hover:bg-white/10\'\n                    : \'border-zinc-900/20 text-zinc-900 hover:bg-zinc-900/5\'\n                }`}\n              >\n                <span>Eksplorasi Karya</span>\n                <ArrowUpRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Right Column: Institutional Identity Dossier Card */}\n          <div className=\"lg:col-span-5\">\n            <div\n              className={`h-full rounded-2xl border p-6 sm:p-8 flex flex-col justify-between ${\n                darkMode\n                  ? \'bg-zinc-900/60 border-white/10\'\n                  : \'bg-white border-zinc-900/10\'\n              }`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between gap-4 pb-6 border-b border-current/10\">\n                  <div>\n                    <p className=\"text-xs opacity-60 font-mono\">\n                      IDENTITAS AKADEMIK & PROFESIONAL\n                    </p>\n                    <h3 className=\"font-display font-bold text-lg sm:text-xl mt-1\">\n                      {PROFILE_DATA.fullName}\n                    </h3>\n                  </div>\n                  <span\n                    className={`w-10 h-10 rounded-xl flex items-center justify-center font-serif italic font-bold text-lg shrink-0 ${\n                      darkMode\n                        ? \'bg-white text-zinc-950\'\n                        : \'bg-zinc-950 text-white\'\n                    }`}\n                  >\n                    M\n                  </span>\n                </div>\n\n                <dl className=\"mt-6 space-y-4 text-sm\">\n                  <div className=\"flex flex-col sm:flex-row sm:justify-between gap-1 pb-3 border-b border-current/5\">\n                    <dt className=\"opacity-60\">Institusi Utama</dt>\n                    <dd className=\"font-medium sm:text-right\">\n                      {PROFILE_DATA.institution}\n                    </dd>\n                  </div>\n                  <div className=\"flex flex-col sm:flex-row sm:justify-between gap-1 pb-3 border-b border-current/5\">\n                    <dt className=\"opacity-60\">Fokus Disiplin</dt>\n                    <dd className=\"font-medium sm:text-right\">\n                      Sistem Informasi \302\267 Manajemen Data \302\267 Web UI\n                    </dd>\n                  </div>\n                  <div className=\"flex flex-col sm:flex-row sm:justify-between gap-1 pb-3 border-b border-current/5\">\n                    <dt className=\"opacity-60\">Pendekatan Desain</dt>\n                    <dd className=\"font-medium sm:text-right\">\n                      Monochrome Editorial & High Legibility\n                    </dd>\n                  </div>\n                  <div className=\"flex flex-col sm:flex-row sm:justify-between gap-1\">\n                    <dt className=\"opacity-60\">Status Kolaborasi</dt>\n                    <dd className=\"font-medium sm:text-right\">\n                      Terbuka untuk Proyek & Riset\n                    </dd>\n                  </div>\n                </dl>\n              </div>\n\n              <div className=\"mt-8 pt-4 border-t border-current/10 flex items-center justify-between text-xs opacity-70 font-mono\">\n                <span>NIM \302\267 P1337437123106</span>\n                <span>SEMARANG, ID</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Full-Width Quantitative Proof Strip Below Hero/About Split */}\n        <div className=\"mt-14 pt-10 border-t border-current/10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {PROFILE_DATA.metrics.map((metric) => (\n            <div\n              key={metric.label}\n              className={`rounded-2xl border p-6 transition-colors ${\n                darkMode\n                  ? \'bg-zinc-900/40 border-white/10\'\n                  : \'bg-white/80 border-zinc-900/10\'\n              }`}\n            >\n              <p className=\"font-display font-extrabold text-3xl sm:text-4xl tracking-tight tabular-nums\">\n                {metric.value}\n              </p>\n              <p className=\"font-semibold text-sm mt-2\">{metric.label}</p>\n              <p className=\"text-xs opacity-65 mt-1\">{metric.detail}</p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Curriculum Vitae Summary Modal */}\n      {cvModalOpen && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"cv-modal-title\"\n          className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm\"\n        >\n          <div\n            className={`w-full max-w-2xl rounded-2xl border p-6 sm:p-8 max-h-[85vh] overflow-y-auto ${\n              darkMode\n                ? \'bg-zinc-900 border-white/15 text-zinc-100\'\n                : \'bg-white border-zinc-900/15 text-zinc-900\'\n            }`}\n          >\n            <div className=\"flex items-start justify-between gap-4 pb-4 border-b border-current/10\">\n              <div>\n                <p className=\"font-mono text-xs uppercase tracking-widest opacity-60\">\n                  DOKUMEN RINGKASAN CV\n                </p>\n                <h3\n                  id=\"cv-modal-title\"\n                  className=\"font-display font-bold text-xl sm:text-2xl mt-1\"\n                >\n                  {PROFILE_DATA.fullName}\n                </h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setCvModalOpen(false)}\n                aria-label=\"Tutup Ringkasan CV\"\n                className=\"p-2 rounded-lg border border-current/15 hover:bg-current/5 cursor-pointer\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"mt-6 space-y-6 text-sm\">\n              <div>\n                <h4 className=\"font-mono text-xs uppercase tracking-wider opacity-60\">\n                  Pendidikan\n                </h4>\n                <p className=\"font-semibold text-base mt-1\">\n                  Politeknik Kesehatan Kemenkes Semarang\n                </p>\n                <p className=\"opacity-75 text-xs mt-0.5\">\n                  IPK Kumulatif: 3.88 / 4.00 \302\267 Fokus Sistem Informasi, Analitik Data & Kepemimpinan Mahasiswa\n                </p>\n              </div>\n\n              <div>\n                <h4 className=\"font-mono text-xs uppercase tracking-wider opacity-60\">\n                  Kompetensi Utama\n                </h4>\n                <p className=\"mt-1 leading-relaxed opacity-85\">\n                  Perancangan Antarmuka Web Modern (React, TypeScript, Tailwind CSS) \302\267 Pengolahan & Validasi Data Statistik \302\267 Penyusunan Standar Operasional Prosedur (SOP) Digital \302\267 Manajemen Proyek Lintas Divisi.\n                </p>\n              </div>\n\n              <div>\n                <h4 className=\"font-mono text-xs uppercase tracking-wider opacity-60\">\n                  Kontak Resmi\n                </h4>\n                <p className=\"mt-1 font-mono text-xs\">\n                  Email: {PROFILE_DATA.email} \302\267 Domisili: {PROFILE_DATA.location}\n                </p>\n              </div>\n            </div>\n\n            <div className=\"mt-8 pt-4 border-t border-current/10 flex justify-end gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setCvModalOpen(false);\n                  onNavigate(\'contact\');\n                }}\n                className={`px-4 py-2 rounded-xl text-xs font-semibold cursor-pointer ${\n                  darkMode\n                    ? \'bg-white text-zinc-950 hover:bg-zinc-200\'\n                    : \'bg-zinc-950 text-white hover:bg-zinc-800\'\n                }`}\n              >\n                Hubungi untuk CV Lengkap\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setCvModalOpen(false)}\n                className=\"px-4 py-2 rounded-xl text-xs font-semibold border border-current/20 cursor-pointer\"\n              >\n                Tutup\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n};\n"
