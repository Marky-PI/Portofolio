            lines {
              text: "      const rect = renderer.domElement.getBoundingClientRect();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      pointerNdc.x = ((clientX - rect.left) / rect.width) * 2 - 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
