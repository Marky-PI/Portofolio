  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Menu, Moon, Sun, X } from \'lucide-react\';\nimport { NAV_ITEMS, type NavSectionId } from \'../data/portfolioData\';\n\ninterface NavbarProps {\n  activeSection: NavSectionId;\n  onNavigate: (sectionId: NavSectionId) => void;\n  darkMode: boolean;\n  onToggleDarkMode: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeSection,\n  onNavigate,\n  darkMode,\n  onToggleDarkMode,\n}) => {\n  const [hoveredId, setHoveredId] = useState<NavSectionId | null>(null);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const brandItem = NAV_ITEMS.find((item) => item.isBrand)!;\n  const centerItems = NAV_ITEMS.filter((item) => !item.isBrand && !item.isCta);\n  const ctaItem = NAV_ITEMS.find((item) => item.isCta)!;\n\n  const handleNavClick = (\n    e: React.MouseEvent<HTMLAnchorElement>,\n    id: NavSectionId\n  ) => {\n    e.preventDefault();\n    onNavigate(id);\n    setMobileMenuOpen(false);\n  };\n\n  return (\n    <header className=\"fixed top-4 sm:top-6 inset-x-0 z-50 px-4 sm:px-8 pointer-events-none\">\n      <div\n        className={`max-w-[1160px] mx-auto pointer-events-auto rounded-2xl backdrop-blur-xl border transition-all duration-300 px-4 sm:px-6 py-3 flex items-center justify-between gap-4 sm:gap-8 ${\n          darkMode\n            ? \'bg-zinc-900/75 border-white/15 text-zinc-100 shadow-[0_12px_40px_rgba(0,0,0,0.55)]\'\n            : \'bg-white/75 border-zinc-900/10 text-zinc-900 shadow-[0_10px_35px_rgba(0,0,0,0.06)]\'\n        }`}\n      >\n        {/* Zone 1: Brand (Mahesa) */}\n        <a\n          href={`#${brandItem.id}`}\n          onClick={(e) => handleNavClick(e, brandItem.id)}\n          className=\"group flex items-center gap-3 whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4\"\n          aria-label=\"Mahesa \342\200\224 Kembali ke Beranda\"\n        >\n          <span\n            className={`w-9 h-9 rounded-xl flex items-center justify-center font-serif italic font-bold text-base transition-transform duration-200 group-hover:scale-105 ${\n              darkMode\n                ? \'bg-zinc-100 text-zinc-950 shadow-sm\'\n                : \'bg-zinc-950 text-white shadow-sm\'\n            }`}\n          >\n            M\n          </span>\n          <span className=\"font-display font-bold text-sm sm:text-base tracking-[0.18em] uppercase transition-opacity duration-200 group-hover:opacity-80\">\n            {brandItem.label}\n          </span>\n        </a>\n\n        {/* Zone 2: Center Navigation Links (About - Experience - Competencies - Certification - Projects) */}\n        <nav\n          aria-label=\"Navigasi Utama Portofolio\"\n          className=\"hidden lg:flex items-center gap-1 xl:gap-2\"\n          onMouseLeave={() => setHoveredId(null)}\n        >\n          {centerItems.map((item) => {\n            const isActive = activeSection === item.id;\n            const isHovered = hoveredId === item.id;\n\n            return (\n              <a\n                key={item.id}\n                href={`#${item.id}`}\n                onClick={(e) => handleNavClick(e, item.id)}\n                onMouseEnter={() => setHoveredId(item.id)}\n                className={`relative px-3.5 py-2 rounded-xl text-xs xl:text-[13px] font-medium tracking-[0.12em] uppercase whitespace-nowrap shrink-0 transition-all duration-200 ${\n                  isActive\n                    ? darkMode\n                      ? \'text-white font-semibold\'\n                      : \'text-zinc-950 font-semibold\'\n                    : darkMode\n                      ? \'text-zinc-400 hover:text-zinc-100\'\n                      : \'text-zinc-600 hover:text-zinc-950\'\n                }`}\n              >\n                {/* Glass Hover Pill Indicator */}\n                <span\n                  aria-hidden=\"true\"\n                  className={`absolute inset-0 rounded-xl transition-all duration-200 ${\n                    isHovered\n                      ? darkMode\n                        ? \'bg-white/10 opacity-100 scale-100\'\n                        : \'bg-zinc-900/[0.06] opacity-100 scale-100\'\n                      : isActive\n                        ? darkMode\n                          ? \'bg-white/[0.06] opacity-100 scale-100\'\n                          : \'bg-zinc-900/[0.04] opacity-100 scale-100\'\n                        : \'opacity-0 scale-95\'\n                  }`}\n                />\n\n                {/* Menu Text */}\n                <span className=\"relative z-10 inline-block transition-transform duration-200\">\n                  {item.label}\n                </span>\n\n                {/* Smooth Bottom Line Indicator */}\n                <span\n                  aria-hidden=\"true\"\n                  className={`absolute bottom-1 left-3.5 right-3.5 h-[1.5px] transition-transform duration-200 origin-center ${\n                    darkMode ? \'bg-zinc-100\' : \'bg-zinc-900\'\n                  } ${\n                    isActive || isHovered ? \'scale-x-100\' : \'scale-x-0\'\n                  }`}\n                />\n              </a>\n            );\n          })}\n        </nav>\n\n        {/* Zone 3: Theme Toggle & Contact Me Button */}\n        <div className=\"flex items-center gap-2.5 shrink-0\">\n          <button\n            type=\"button\"\n            onClick={onToggleDarkMode}\n            aria-label={\n              darkMode\n                ? \'Ubah ke Tema Monokrom Terang\'\n                : \'Ubah ke Tema Monokrom Gelap\'\n            }\n            className={`w-10 h-10 rounded-xl border flex items-center justify-center transition-all duration-200 cursor-pointer ${\n              darkMode\n                ? \'border-white/15 bg-white/5 text-zinc-200 hover:bg-white/15\'\n                : \'border-zinc-900/12 bg-zinc-900/[0.03] text-zinc-800 hover:bg-zinc-900/10\'\n            }`}\n          >\n            {darkMode ? (\n              <Sun className=\"w-4 h-4\" />\n            ) : (\n              <Moon className=\"w-4 h-4\" />\n            )}\n          </button>\n\n          <a\n            href={`#${ctaItem.id}`}\n            onClick={(e) => handleNavClick(e, ctaItem.id)}\n            className={`hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold tracking-wide whitespace-nowrap shrink-0 border transition-all duration-200 ${\n              activeSection === ctaItem.id\n                ? darkMode\n                  ? \'bg-white text-zinc-950 border-white shadow-sm\'\n                  : \'bg-zinc-950 text-white border-zinc-950 shadow-sm\'\n                : darkMode\n                  ? \'border-zinc-200 text-zinc-100 hover:bg-white hover:text-zinc-950\'\n                  : \'border-zinc-900 text-zinc-900 hover:bg-zinc-950 hover:text-white\'\n            }`}\n          >\n            {ctaItem.label}\n          </a>\n\n          {/* Mobile Hamburger Trigger */}\n          <button\n            type=\"button\"\n            onClick={() => setMobileMenuOpen((prev) => !prev)}\n            aria-label={mobileMenuOpen ? \'Tutup Menu Navigasi\' : \'Buka Menu Navigasi\'}\n            aria-expanded={mobileMenuOpen}\n            className={`lg:hidden w-10 h-10 rounded-xl border flex items-center justify-center transition-colors cursor-pointer ${\n              darkMode\n                ? \'border-white/15 bg-white/5 text-zinc-100 hover:bg-white/10\'\n                : \'border-zinc-900/15 bg-zinc-900/5 text-zinc-900 hover:bg-zinc-900/10\'\n            }`}\n          >\n            {mobileMenuOpen ? <X className=\"w-4 h-4\" /> : <Menu className=\"w-4 h-4\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Responsive Mobile Glass Drawer */}\n      {mobileMenuOpen && (\n        <div\n          className={`lg:hidden max-w-[1160px] mx-auto mt-2 pointer-events-auto rounded-2xl backdrop-blur-xl border p-4 transition-all ${\n            darkMode\n              ? \'bg-zinc-900/90 border-white/15 text-zinc-100 shadow-2xl\'\n              : \'bg-white/90 border-zinc-900/10 text-zinc-900 shadow-xl\'\n          }`}\n        >\n          <div className=\"flex flex-col gap-1\">\n            {centerItems.map((item) => {\n              const isActive = activeSection === item.id;\n              return (\n                <a\n                  key={item.id}\n                  href={`#${item.id}`}\n                  onClick={(e) => handleNavClick(e, item.id)}\n                  className={`px-4 py-2.5 rounded-xl text-xs font-semibold tracking-[0.14em] uppercase transition-colors ${\n                    isActive\n                      ? darkMode\n                        ? \'bg-white/15 text-white\'\n                        : \'bg-zinc-900/10 text-zinc-950\'\n                      : darkMode\n                        ? \'text-zinc-300 hover:bg-white/10\'\n                        : \'text-zinc-600 hover:bg-zinc-900/5\'\n                  }`}\n                >\n                  {item.label}\n                </a>\n              );\n            })}\n            <a\n              href={`#${ctaItem.id}`}\n              onClick={(e) => handleNavClick(e, ctaItem.id)}\n              className={`mt-2 px-4 py-2.5 rounded-xl text-center text-xs font-semibold tracking-wider uppercase border transition-colors ${\n                darkMode\n                  ? \'bg-white text-zinc-950 border-white\'\n                  : \'bg-zinc-950 text-white border-zinc-950\'\n              }`}\n            >\n              {ctaItem.label}\n            </a>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
