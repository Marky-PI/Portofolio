            lines {
              text: "  roleHeadline: \'Health Informatics, Digital Systems & Applied Research Professional\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  bioLead:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \'Mengelola Informasi Kesehatan dengan Akurat, Terstruktur, dan Terpercaya.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  bioParagraphs: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \'Saya merupakan lulusan D3 Rekam Medis dan Informasi Kesehatan dari Poltekkes Kemenkes Semarang dengan IPK 3,79. Saya memiliki ketertarikan pada pengelolaan rekam medis, sistem informasi manajemen rumah sakit (SIMRS), serta pengembangan dan evaluasi rekam medis elektronik (RME).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \'Melalui pengalaman praktik di rumah sakit dan puskesmas, saya mempelajari proses pelayanan rekam medis, administrasi pasien, pengelolaan informasi kesehatan, serta kegiatan pelayanan kesehatan masyarakat. Saya juga memiliki pengalaman membantu entri data rekam medis menggunakan SIMRS dan mempelajari evaluasi implementasi RME menggunakan kerangka HOT-FIT.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \'Saya mengutamakan ketelitian, kerahasiaan informasi, dan keteraturan data dalam mendukung mutu pelayanan kesehatan. Bagi saya, rekam medis bukan sekadar dokumentasi, melainkan bagian penting dalam kesinambungan pelayanan, penyediaan informasi yang akurat, dan pengambilan keputusan di fasilitas kesehatan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
