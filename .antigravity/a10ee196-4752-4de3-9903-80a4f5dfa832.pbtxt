            lines {
              text: "        const halfW = ribbonWidth * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const dx = Math.cos(twistAngle) * halfW;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const dz = Math.sin(twistAngle) * halfW;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        posAttr.setXYZ(i * 2, pt.x - dx, pt.y, pt.z - dz);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        posAttr.setXYZ(i * 2 + 1, pt.x + dx, pt.y, pt.z + dz);"
