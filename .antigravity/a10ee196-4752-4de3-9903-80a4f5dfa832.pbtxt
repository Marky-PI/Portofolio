tail: \'Audit & Pengolahan Instrumen\' },\n    { value: \'6+\', label: \'Sertifikasi Kompetensi\', detail: \'Kemenkes & Lembaga Nasional\' },\n    { value: \'3.88\', label: \'Indeks Prestasi Kumulatif\', detail: \'Poltekkes Kemenkes Semarang\' },\n  ],\n};\n\nexport const EXPERIENCE_DATA: ExperienceItem[] = [\n  {\n    id: \'exp-01\',\n    role: \'Project Lead \342\200\224 Digitalisasi Sistem Informasi & Dokumentasi Terpadu\',\n    organization: \'Poltekkes Kemenkes Semarang\',\n    location: \'Semarang, Indonesia\',\n    period: \'2025 \342\200\224 Sekarang\',\n    category: \'Academic & Clinical\',\n    summary:\n      \'Memimpin inisiatif transformasi alur pelaporan akademik dan pencatatan data lapangan menggunakan antarmuka web responsif dan basis data terstruktur.\',\n    highlights: [\n      \'Merancang arsitektur formulir digital yang memangkas waktu rekapitulasi data bulanan sebesar 42%.\',\n      \'Menyusun standar operasional prosedur (SOP) verifikasi data bagi 45+ anggota tim lintas divisi.\',\n      \'Mengintegrasikan visualisasi metrik capaian secara real-time untuk evaluasi program berkala.\',\n    ],\n    metrics: \'-42% Waktu Rekapitulasi Data\',\n  },\n  {"
