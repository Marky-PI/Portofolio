              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Platform web terintegrasi untuk memantau pengumpulan data survei lapangan, verifikasi progres tim secara real-time, dan pembuatan laporan otomatis.\',"
