            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const updateRibbonGeometry = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const st = physicsRef.current;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Top of clamp in world space"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const clampTopOffset = new THREE.Vector3(0, cardH / 2 + 0.54, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const clampTopOffset = new THREE.Vector3(0, cardH / 2 + 0.52, 0);"
