          target_content: "export function createLanyardPhysicsState(): LanyardPhysicsState {\n  // Anchor [0] is pinned at the very top edge of the About section viewport (y = 4.65).\n  // Free nodes [1..4] start high above the top edge so the lanyard drops down from above\n  // when entering the About section.\n  const anchorY = 4.65;\n  const seg = 0.72;\n\n  const state: LanyardPhysicsState = {\n    nodes: [\n      {\n        pos: { x: 0, y: anchorY, z: 0 },\n        prevPos: { x: 0, y: anchorY, z: 0 },\n        lerped: { x: 0, y: anchorY, z: 0 },\n        pinned: true,\n      },\n      {\n        pos: { x: 0.18, y: anchorY + 0.6, z: 0.04 },\n        prevPos: { x: 0.12, y: anchorY + 0.75, z: 0.04 },\n        lerped: { x: 0.18, y: anchorY + 0.6, z: 0.04 },\n        pinned: false,\n      },\n      {\n        pos: { x: 0.36, y: anchorY + 1.1, z: 0.08 },\n        prevPos: { x: 0.25, y: anchorY + 1.3, z: 0.08 },\n        lerped: { x: 0.36, y: anchorY + 1.1, z: 0.08 },\n        pinned: false,\n      },\n      {\n        pos: { x: 0.54, y: anchorY + 1.5, z: 0.12 },\n        prevPos: { x: 0.38, y: anchorY + 1.75, z: 0.12 },\n        lerped: { x: 0.54, y: anchorY + 1.5, z: 0.12 },\n        pinned: false,\n      },\n      {\n        pos: { x: 0.72, y: anchorY + 1.9, z: 0.16 },\n        prevPos: { x: 0.52, y: anchorY + 2.2, z: 0.16 },\n        lerped: { x: 0.72, y: anchorY + 1.9, z: 0.16 },\n        pinned: false,\n      },\n    ],\n    segmentLength: seg,\n    rot: { x: -0.12, y: 0.35, z: 0.18 },\n    angVel: { x: 0, y: -1.8, z: 0 },\n    isDragged: false,\n    dragTarget: { x: 0, y: 0, z: 0 },\n  };\n\n  return state;\n}"
          replacement_content: "export function createLanyardPhysicsState(): LanyardPhysicsState {\n  // Anchor [0] is pinned at the top edge of the About section frustum (y = 3.15).\n  // Free nodes [1..4] start above the top edge so the lanyard drops down from above\n  // when entering the About section and settles in the right-hand space.\n  const anchorY = 3.15;\n  const seg = 0.55;\n\n  const state: LanyardPhysicsState = {\n    nodes: [\n      {\n        pos: { x: 0, y: anchorY, z: 0 },\n        prevPos: { x: 0, y: anchorY, z: 0 },\n        lerped: { x: 0, y: anchorY, z: 0 },\n        pinned: true,\n      },\n      {\n        pos: { x: 0.12, y: anchorY + 0.45, z: 0.03 },\n        prevPos: { x: 0.08, y: anchorY + 0.55, z: 0.03 },\n        lerped: { x: 0.12, y: anchorY + 0.45, z: 0.03 },\n        pinned: false,\n      },\n      {\n        pos: { x: 0.24, y: anchorY + 0.85, z: 0.06 },\n        prevPos: { x: 0.18, y: anchorY + 1.0, z: 0.06 },\n        lerped: { x: 0.24, y: anchorY + 0.85, z: 0.06 },\n        pinned: false,\n      },\n      {\n        pos: { x: 0.35, y: anchorY + 1.25, z: 0.09 },\n        prevPos: { x: 0.26, y: anchorY + 1.45, z: 0.09 },\n        lerped: { x: 0.35, y: anchorY + 1.25, z: 0.09 },\n        pinned: false,\n      },\n      {\n        pos: { x: 0.46, y: anchorY + 1.65, z: 0.12 },\n        prevPos: { x: 0.34, y: anchorY + 1.9, z: 0.12 },\n        lerped: { x: 0.46, y: anchorY + 1.65, z: 0.12 },\n        pinned: false,\n      },\n    ],\n    segmentLength: seg,\n    rot: { x: -0.08, y: 0.28, z: 0.14 },\n    angVel: { x: 0, y: -1.4, z: 0 },\n    isDragged: false,\n    dragTarget: { x: 0, y: 0, z: 0 },\n  };\n\n  return state;\n}"
