            }
            lines {
              text: "      clampTopOffset.add(cardGroup.position);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      curvePoints[0].copy(clampTopOffset);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      curvePoints[1].set("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        st.nodes[2].lerped.x,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        st.nodes[2].lerped.y,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
