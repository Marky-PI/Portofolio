  code_action {
    action_spec {
      command {
        instruction: "Update the CV modal in /src/components/AboutSection.tsx to display /assets/aistudio/CV_ATS_7ce604eb.pdf in a PDF viewer"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/AboutSection.tsx"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "import React, { useState } from \'react\';\nimport { ArrowUpRight, X } from \'lucide-react\';\nimport { PROFILE_DATA, type NavSectionId } from \'../data/portfolioData\';\nimport { ButtonColorful } from \'./ButtonColorful\';\nimport { Lanyard3DCard } from \'./Lanyard3DCard\';\n\ninterface AboutSectionProps {\n  darkMode: boolean;\n  onNavigate: (sectionId: NavSectionId) => void;\n}\n\nexport const AboutSection: React.FC<AboutSectionProps> = ({\n  darkMode,\n  onNavigate,\n}) => {\n  const [cvModalOpen, setCvModalOpen] = useState(false);\n\n  return (\n    <section\n      id=\"about\"\n      aria-labelledby=\"about-heading\"\n      className={`relative overflow-hidden pt-20 sm:pt-28 pb-24 sm:pb-32 px-4 sm:px-8 border-t transition-colors duration-300 ${\n        darkMode\n          ? \'bg-[#0F0F12] border-white/10 text-zinc-100\'\n          : \'bg-[#F4F4F5] border-zinc-900/10 text-zinc-900\'\n      }`}\n    >\n      <div className=\"max-w-[1160px] mx-auto\">\n        {/* 2-Column Editorial Split: Left holds Heading + Description, Right holds Hanging 3D Lanyard from Top Edge */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\">\n          {/* Left Column: Heading, Narrative & CTA */}\n          <div className=\"lg:col-span-7 flex flex-col justify-between space-y-8 pt-2\">\n            <div className=\"pb-8 border-b border-current/10\">\n              <h2\n                id=\"about-heading\"\n                className=\"font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-balance\"\n              >\n                ABOUT ME\n              </h2>\n            </div>\n\n            <div className=\"space-y-5\">\n              <p className=\"font-display text-xl sm:text-2xl font-medium leading-snug tracking-tight\">\n                {PROFILE_DATA.bioLead}\n              </p>\n              {PROFILE_DATA.bioParagraphs.map((paragraph, index) => (\n                <p\n                  key={index}\n                  className={`text-sm sm:text-base leading-relaxed ${\n                    darkMode ? \'text-zinc-300\' : \'text-zinc-600\'\n                  }`}\n                >\n                  {paragraph}\n                </p>\n              ))}\n            </div>\n\n            <div className=\"pt-2 flex flex-wrap items-center gap-3\">\n              <ButtonColorful\n                label=\"Ringkasan Curriculum Vitae\"\n                darkMode={darkMode}\n                onClick={() => setCvModalOpen(true)}\n              />\n\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'projects\')}\n                className={`inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-semibold tracking-wide border transition-all cursor-pointer whitespace-nowrap shrink-0 ${\n                  darkMode\n                    ? \'border-white/20 text-zinc-100 hover:bg-white/10\'\n                    : \'border-zinc-900/20 text-zinc-900 hover:bg-zinc-900/5\'\n                }`}\n              >\n                <span>Eksplorasi Karya</span>\n                <ArrowUpRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Right Column Spacer on Desktop; Full-Width Lanyard Overlay spans the entire About section so dragging never clips */}\n          <div\n            className=\"hidden lg:block lg:col-span-5 h-[520px] pointer-events-none\"\n            aria-hidden=\"true\"\n          />\n        </div>\n\n        {/* Full-Bleed 3D Lanyard Layer: spans 100% of the About section width so the lanyard can be dragged anywhere without box clipping */}\n        <div className=\"relative -mx-4 sm:-mx-8 lg:mx-0 lg:absolute lg:inset-x-0 lg:top-0 z-20 pointer-events-none\">\n          <Lanyard3DCard />\n        </div>\n\n        {/* 4-Column Horizontal Row of Domain Proof Cards */}\n        <div className=\"mt-10 pt-10 border-t border-current/10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5\">\n          {PROFILE_DATA.metrics.map((metric) => (\n            <div\n              key={metric.label}\n              className={`rounded-2xl border px-6 py-5 transition-colors ${\n                darkMode\n                  ? \'bg-zinc-900/60 border-white/10 text-zinc-100\'\n                  : \'bg-white border-zinc-900/10 text-zinc-950 shadow-xs\'\n              }`}\n            >\n              <p className=\"font-display font-semibold text-2xl sm:text-3xl tracking-tight tabular-nums\">\n                {metric.value}\n              </p>\n              <p className=\"font-sans font-normal text-sm sm:text-base mt-1.5\">\n                {metric.label}\n              </p>\n              <p\n                className={`text-xs sm:text-sm mt-1 ${\n                  darkMode ? \'text-zinc-400\' : \'text-zinc-500\'\n                }`}\n              >\n                {metric.detail}\n              </p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Curriculum Vitae Summary Modal */}\n      {cvModalOpen && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"cv-modal-title\"\n          className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm\"\n        >\n          <div\n            className={`w-full max-w-2xl rounded-2xl border p-6 sm:p-8 max-h-[85vh] overflow-y-auto ${\n              darkMode\n                ? \'bg-zinc-900 border-white/15 text-zinc-100\'\n                : \'bg-white border-zinc-900/15 text-zinc-900\'\n            }`}\n          >\n            <div className=\"flex items-start justify-between gap-4 pb-4 border-b border-current/10\">\n              <div>\n                <p className=\"font-mono text-xs uppercase tracking-widest opacity-60\">\n                  DOKUMEN RINGKASAN CV\n                </p>\n                <h3\n                  id=\"cv-modal-title\"\n                  className=\"font-display font-bold text-xl sm:text-2xl mt-1\"\n                >\n                  {PROFILE_DATA.fullName}\n                </h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setCvModalOpen(false)}\n                aria-label=\"Tutup Ringkasan CV\"\n                className=\"p-2 rounded-lg border border-current/15 hover:bg-current/5 cursor-pointer\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"mt-6 space-y-6 text-sm\">\n              <div>\n                <h4 className=\"font-mono text-xs uppercase tracking-wider opacity-60\">\n                  Pendidikan\n                </h4>\n                <p className=\"font-semibold text-base mt-1\">\n                  Politeknik Kesehatan Kemenkes Semarang\n                </p>\n                <p className=\"opacity-75 text-xs mt-0.5\">\n                  IPK Kumulatif: 3.88 / 4.00 \302\267 Fokus Sistem Informasi, Analitik Data & Kepemimpinan Mahasiswa\n                </p>\n              </div>\n\n              <div>\n                <h4 className=\"font-mono text-xs uppercase tracking-wider opacity-60\">\n                  Kompetensi Utama\n                </h4>\n                <p className=\"mt-1 leading-relaxed opacity-85\">\n                  Perancangan Antarmuka Web Modern (React, TypeScript, Tailwind CSS) \302\267 Pengolahan & Validasi Data Statistik \302\267 Penyusunan Standar Operasional Prosedur (SOP) Digital \302\267 Manajemen Proyek Lintas Divisi.\n                </p>\n              </div>\n\n              <div>\n                <h4 className=\"font-mono text-xs uppercase tracking-wider opacity-60\">\n                  Kontak Resmi\n                </h4>\n                <p className=\"mt-1 font-mono text-xs\">\n                  Email: {PROFILE_DATA.email}\n                </p>\n              </div>\n            </div>\n\n            <div className=\"mt-8 pt-4 border-t border-current/10 flex justify-end gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setCvModalOpen(false);\n                  onNavigate(\'contact\');\n                }}\n                className={`px-4 py-2 rounded-xl text-xs font-semibold cursor-pointer ${\n                  darkMode\n                    ? \'bg-white text-zinc-950 hover:bg-zinc-200\'\n                    : \'bg-zinc-950 text-white hover:bg-zinc-800\'\n                }`}\n              >\n                Hubungi untuk CV Lengkap\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setCvModalOpen(false)}\n                className=\"px-4 py-2 rounded-xl text-xs font-semibold border border-current/20 cursor-pointer\"\n              >\n                Tutup\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n};"
          replacement_content: "import React, { useState } from \'react\';\nimport { ArrowUpRight, Download, FileText, X } from \'lucide-react\';\nimport { PROFILE_DATA, type NavSectionId } from \'../data/portfolioData\';\nimport { ButtonColorful } from \'./ButtonColorful\';\nimport { Lanyard3DCard } from \'./Lanyard3DCard\';\n\nconst CV_PDF_URL = \'/assets/aistudio/CV_ATS_7ce604eb.pdf\';\n\ninterface AboutSectionProps {\n  darkMode: boolean;\n  onNavigate: (sectionId: NavSectionId) => void;\n}\n\nexport const AboutSection: React.FC<AboutSectionProps> = ({\n  darkMode,\n  onNavigate,\n}) => {\n  const [cvModalOpen, setCvModalOpen] = useState(false);\n\n  return (\n    <section\n      id=\"about\"\n      aria-labelledby=\"about-heading\"\n      className={`relative overflow-hidden pt-20 sm:pt-28 pb-24 sm:pb-32 px-4 sm:px-8 border-t transition-colors duration-300 ${\n        darkMode\n          ? \'bg-[#0F0F12] border-white/10 text-zinc-100\'\n          : \'bg-[#F4F4F5] border-zinc-900/10 text-zinc-900\'\n      }`}\n    >\n      <div className=\"max-w-[1160px] mx-auto\">\n        {/* 2-Column Editorial Split: Left holds Heading + Description, Right holds Hanging 3D Lanyard from Top Edge */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\">\n          {/* Left Column: Heading, Narrative & CTA */}\n          <div className=\"lg:col-span-7 flex flex-col justify-between space-y-8 pt-2\">\n            <div className=\"pb-8 border-b border-current/10\">\n              <h2\n                id=\"about-heading\"\n                className=\"font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-balance\"\n              >\n                ABOUT ME\n              </h2>\n            </div>\n\n            <div className=\"space-y-5\">\n              <p className=\"font-display text-xl sm:text-2xl font-medium leading-snug tracking-tight\">\n                {PROFILE_DATA.bioLead}\n              </p>\n              {PROFILE_DATA.bioParagraphs.map((paragraph, index) => (\n                <p\n                  key={index}\n                  className={`text-sm sm:text-base leading-relaxed ${\n                    darkMode ? \'text-zinc-300\' : \'text-zinc-600\'\n                  }`}\n                >\n                  {paragraph}\n                </p>\n              ))}\n            </div>\n\n            <div className=\"pt-2 flex flex-wrap items-center gap-3\">\n              <ButtonColorful\n                label=\"Ringkasan Curriculum Vitae\"\n                darkMode={darkMode}\n                onClick={() => setCvModalOpen(true)}\n              />\n\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'projects\')}\n                className={`inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-semibold tracking-wide border transition-all cursor-pointer whitespace-nowrap shrink-0 ${\n                  darkMode\n                    ? \'border-white/20 text-zinc-100 hover:bg-white/10\'\n                    : \'border-zinc-900/20 text-zinc-900 hover:bg-zinc-900/5\'\n                }`}\n              >\n                <span>Eksplorasi Karya</span>\n                <ArrowUpRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Right Column Spacer on Desktop; Full-Width Lanyard Overlay spans the entire About section so dragging never clips */}\n          <div\n            className=\"hidden lg:block lg:col-span-5 h-[520px] pointer-events-none\"\n            aria-hidden=\"true\"\n          />\n        </div>\n\n        {/* Full-Bleed 3D Lanyard Layer: spans 100% of the About section width so the lanyard can be dragged anywhere without box clipping */}\n        <div className=\"relative -mx-4 sm:-mx-8 lg:mx-0 lg:absolute lg:inset-x-0 lg:top-0 z-20 pointer-events-none\">\n          <Lanyard3DCard />\n        </div>\n\n        {/* 4-Column Horizontal Row of Domain Proof Cards */}\n        <div className=\"mt-10 pt-10 border-t border-current/10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5\">\n          {PROFILE_DATA.metrics.map((metric) => (\n            <div\n              key={metric.label}\n              className={`rounded-2xl border px-6 py-5 transition-colors ${\n                darkMode\n                  ? \'bg-zinc-900/60 border-white/10 text-zinc-100\'\n                  : \'bg-white border-zinc-900/10 text-zinc-950 shadow-xs\'\n              }`}\n            >\n              <p className=\"font-display font-semibold text-2xl sm:text-3xl tracking-tight tabular-nums\">\n                {metric.value}\n              </p>\n              <p className=\"font-sans font-normal text-sm sm:text-base mt-1.5\">\n                {metric.label}\n              </p>\n              <p\n                className={`text-xs sm:text-sm mt-1 ${\n                  darkMode ? \'text-zinc-400\' : \'text-zinc-500\'\n                }`}\n              >\n                {metric.detail}\n              </p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Curriculum Vitae PDF Viewer Modal */}\n      {cvModalOpen && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"cv-modal-title\"\n          onClick={() => setCvModalOpen(false)}\n          className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/75 backdrop-blur-sm\"\n        >\n          <div\n            onClick={(e) => e.stopPropagation()}\n            className={`w-full max-w-4xl rounded-2xl border p-4 sm:p-6 flex flex-col max-h-[92vh] shadow-2xl ${\n              darkMode\n                ? \'bg-zinc-900 border-white/15 text-zinc-100\'\n                : \'bg-white border-zinc-900/15 text-zinc-900\'\n            }`}\n          >\n            <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-current/10\">\n              <div className=\"flex items-center gap-3\">\n                <div\n                  className={`w-10 h-10 rounded-xl flex items-center justify-center border ${\n                    darkMode\n                      ? \'bg-zinc-800 border-white/10 text-zinc-100\'\n                      : \'bg-zinc-100 border-zinc-900/10 text-zinc-900\'\n                  }`}\n                >\n                  <FileText className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <p className=\"font-mono text-[11px] uppercase tracking-widest opacity-60\">\n                    CURRICULUM VITAE \302\267 PDF VIEWER\n                  </p>\n                  <h3\n                    id=\"cv-modal-title\"\n                    className=\"font-display font-bold text-base sm:text-lg\"\n                  >\n                    Mahesa Rizky Putra Irdiansyah\n                  </h3>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <a\n                  href={CV_PDF_URL}\n                  download=\"CV_Mahesa_Rizky_Putra_Irdiansyah.pdf\"\n                  className={`inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold transition-colors ${\n                    darkMode\n                      ? \'bg-white text-zinc-950 hover:bg-zinc-200\'\n                      : \'bg-zinc-950 text-white hover:bg-zinc-800\'\n                  }`}\n                >\n                  <Download className=\"w-3.5 h-3.5\" />\n                  <span>Unduh PDF</span>\n                </a>\n                <button\n                  type=\"button\"\n                  onClick={() => setCvModalOpen(false)}\n                  aria-label=\"Tutup Penampil CV\"\n                  className=\"p-2 rounded-xl border border-current/15 hover:bg-current/5 cursor-pointer\"\n                >\n                  <X className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n\n            <div className=\"mt-4 flex-1 min-h-0 overflow-hidden rounded-xl border border-current/10 bg-zinc-950/5\">\n              <iframe\n                src={`${CV_PDF_URL}#view=FitH`}\n                title=\"Curriculum Vitae Mahesa Rizky Putra Irdiansyah\"\n                className=\"w-full h-[72vh] border-0\"\n              />\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n};"
