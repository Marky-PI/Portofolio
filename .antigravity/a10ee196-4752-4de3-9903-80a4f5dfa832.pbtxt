          target_content: "export function getMarqueeDurationSeconds(speed: \'slow\' | \'normal\' | \'fast\'): number {\n  switch (speed) {\n    case \'slow\':\n      return 38;\n    case \'fast\':\n      return 16;\n    case \'normal\':\n    default:\n      return 26;\n  }\n}"
          replacement_content: "export function getMarqueeDurationSeconds(speed: \'slow\' | \'normal\' | \'fast\'): number {\n  switch (speed) {\n    case \'slow\':\n      return 38;\n    case \'fast\':\n      return 16;\n    case \'normal\':\n    default:\n      return 26;\n  }\n}\n\n/**\n * Smooth cinematic easing curve (easeInOutCubic) for programmatic navigation scrolling.\n */\nexport function easeInOutCubic(t: number): number {\n  const clamped = Math.max(0, Math.min(1, t));\n  return clamped < 0.5\n    ? 4 * clamped * clamped * clamped\n    : 1 - Math.pow(-2 * clamped + 2, 3) / 2;\n}\n\nexport function interpolateScrollY(\n  startY: number,\n  targetY: number,\n  progress: number\n): number {\n  const eased = easeInOutCubic(progress);\n  return startY + (targetY - startY) * eased;\n}\n"
          start_line: 109
          end_line: 121
        }
      }
    }
