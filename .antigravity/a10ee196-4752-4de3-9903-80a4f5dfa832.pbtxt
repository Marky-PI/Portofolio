    end_line: 197
    content: "import React, { useState } from \'react\';\nimport { ChevronDown, ChevronUp } from \'lucide-react\';\nimport { EXPERIENCE_DATA } from \'../data/portfolioData\';\nimport { filterExperiencesByCategory } from \'../utils/portfolioLogic\';\n\ninterface ExperienceSectionProps {\n  darkMode: boolean;\n}\n\nconst CATEGORIES = [\n  \'All\',\n  \'Academic & Clinical\',\n  \'Primary Healthcare\',\n] as const;\n\nexport const ExperienceSection: React.FC<ExperienceSectionProps> = ({\n  darkMode,\n}) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'All\');\n  const [expandedId, setExpandedId] = useState<string>(EXPERIENCE_DATA[0].id);\n\n  const filteredExperiences = filterExperiencesByCategory(\n    EXPERIENCE_DATA,\n    selectedCategory\n  );\n\n  return (\n    <section\n      id=\"experience\"\n      aria-labelledby=\"experience-heading\"\n      className={`py-24 sm:py-32 px-4 sm:px-8 border-t transition-colors duration-300 ${\n        darkMode\n          ? \'bg-[#0B0B0D] border-white/10 text-zinc-100\'\n          : \'bg-[#E5E5E5] border-zinc-900/10 text-zinc-900\'\n      }`}\n    >\n      <div className=\"max-w-[1160px] mx-auto\">\n        {/* Header & Interactive Segmented Filter */}\n        <div className=\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-12 border-b border-current/10\">\n          <div>\n            <h2\n              id=\"experience-heading\"\n              className=\"font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight mt-2 text-balance\"\n            >\n              My Experience\n            </h2>\n          </div>\n\n          {/* Interactive Filter Controls */}\n          <div\n            role=\"group\"\n            aria-label=\"Filter Kategori Pengalaman\"\n            className={`inline-flex items-center gap-1 p-1.5 rounded-xl border overflow-x-auto max-w-full shrink-0 ${\n              darkMode\n                ? \'bg-zinc-900/80 border-white/10\'\n                : \'bg-white/75 border-zinc-900/10\'\n            }`}\n          >\n            {CATEGORIES.map((category) => {\n              const active = selectedCategory === category;\n              return (\n                <button\n                  key={category}\n                  type=\"button\"\n                  onClick={() => setSelectedCategory(category)}\n                  className={`px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer whitespace-nowrap shrink-0 ${\n                    active\n                      ? darkMode\n                        ? \'bg-white text-zinc-950 font-semibold shadow-sm\'\n                        : \'bg-zinc-950 text-white font-semibold shadow-sm\'\n                      : darkMode\n                        ? \'text-zinc-400 hover:text-white\'\n                        : \'text-zinc-600 hover:text-zinc-950\'\n                  }`}\n                >\n                  {category}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Experience List */}\n        <div className=\"mt-10 space-y-5\">\n          {filteredExperiences.map((exp, idx) => {\n            const isExpanded = expandedId === exp.id;\n            return (\n              <article\n                key={exp.id}\n                className={`rounded-2xl border transition-all duration-200 ${\n                  darkMode\n                    ? \'bg-zinc-900/60 border-white/10 hover:border-white/25\'\n                    : \'bg-white/85 border-zinc-900/10 hover:border-zinc-900/25\'\n                }`}\n              >\n                <div className=\"p-6 sm:p-8\">\n                  <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n                    <div className=\"space-y-1.5\">\n                      {/* Unboxed Metadata with Typographic Separators */}\n                      <div className=\"flex flex-wrap items-center gap-2 text-xs font-mono opacity-65 tabular-nums\">\n                        <span>0{idx + 1}</span>\n                        <span aria-hidden=\"true\">\302\267</span>\n                        <span>{exp.period}</span>\n                        <span aria-hidden=\"true\">\302\267</span>\n                        <span>{exp.category}</span>\n                        <span aria-hidden=\"true\">\302\267</span>\n                        <span>{exp.location}</span>\n                      </div>\n\n                      <h3 className=\"font-display font-bold text-xl sm:text-2xl tracking-tight\">\n                        {exp.role}\n                      </h3>\n\n                      {exp.organization && (\n                        <p className=\"text-sm font-medium opacity-80\">\n                          {exp.organization}\n                        </p>\n                      )}\n                    </div>\n\n                    <div className=\"flex items-center justify-between lg:justify-end gap-4 pt-2 lg:pt-0 border-t lg:border-t-0 border-current/10\">\n                      {exp.metrics && (\n                        <span className=\"font-mono text-xs font-medium opacity-80 tabular-nums\">\n                          {exp.metrics}\n                        </span>\n                      )}\n\n                      <button\n                        type=\"button\"\n                        onClick={() =>\n                          setExpandedId(isExpanded ? \'\' : exp.id)\n                        }\n                        aria-expanded={isExpanded}\n                        aria-label={\n                          isExpanded\n                            ? `Sembunyikan detail ${exp.role}`\n                            : `Lihat detail ${exp.role}`\n                        }\n                        className={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold border transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\n                          darkMode\n                            ? \'border-white/15 hover:bg-white/10\'\n                            : \'border-zinc-900/15 hover:bg-zinc-900/5\'\n                        }`}\n                      >\n                        <span>{isExpanded ? \'Ringkas\' : \'Detail Kegiatan\'}</span>\n                        {isExpanded ? (\n                          <ChevronUp className=\"w-3.5 h-3.5\" />\n                        ) : (\n                          <ChevronDown className=\"w-3.5 h-3.5\" />\n                        )}\n                      </button>\n                    </div>\n                  </div>\n\n                  <p\n                    className={`mt-4 text-sm sm:text-base leading-relaxed ${\n                      darkMode ? \'text-zinc-300\' : \'text-zinc-600\'\n                    }`}\n                  >\n                    {exp.summary}\n                  </p>\n\n                  {isExpanded && (\n                    <div className=\"mt-6 pt-6 border-t border-current/10\">\n                      <p className=\"font-mono text-xs uppercase tracking-wider opacity-60 mb-3\">\n                        Kontribusi & Kegiatan Utama\n                      </p>\n                      <ul className=\"space-y-2.5 text-sm\">\n                        {exp.highlights.map((item, i) => (\n                          <li\n                            key={i}\n                            className=\"flex items-start gap-3 leading-relaxed\"\n                          >\n                            <span className=\"font-mono text-xs opacity-50 mt-0.5 tabular-nums\">\n                              0{i + 1}.\n                            </span>\n                            <span\n                              className={\n                                darkMode ? \'text-zinc-200\' : \'text-zinc-700\'\n                              }\n                            >\n                              {item}\n                            </span>\n                          </li>\n                        ))}\n                      </ul>\n                    </div>\n                  )}\n                </div>\n              </article>\n            );\n          })}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 198
    num_bytes: 7860
    line_range_bytes: 7860
  }
}
